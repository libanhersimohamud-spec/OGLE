//@version=6
// =============================================================================
// Fractal-OGLE-Structure (FOS)  —  Pine Script v6
// Version 2.0  —  Structure-ID engine, explicit finite-state machine.
//
// ARCHITECTURE OVERVIEW
//   * Confirmed Bill Williams fractals, CONFIGURABLE period (no hardcoded 2).
//   * Never repaints: all transitions run on `barstate.isconfirmed`; fractals
//     confirm via ta.pivothigh/ta.pivotlow(N, N) -> N bars after the pivot.
//   * One explicit state variable (no boolean soup):
//         STATE_NO_STRUCTURE / STATE_WAITING /
//         STATE_ACTIVE_SELL  / STATE_ACTIVE_BUY
//   * Structure-ID system: every confirmed structure is an immutable object
//     with a unique incrementing ID; only the single ACTIVE structure is ever
//     mutated. COMPLETED / INVALID structures are frozen forever and kept in an
//     array for history / future features. Only the ACTIVE one is drawn.
//
// AGREED DECISIONS (user-confirmed):
//   Q1  Leg A = WICK/GAP invalidation -> structure INVALID -> NO_STRUCTURE.
//       (Original "body-close reversal creates opposite leg" is REMOVED;
//        opposite direction can only arise from a fresh structureless BOS.)
//   Q2  Continuation = "freeze-then-seed": on a Leg B break the old structure
//       is COMPLETED and the SAME break candle becomes the new same-direction
//       BOS Candidate (Rule 6 forbids only the INVALIDATION candle from seeding).
//   Q3  Continuation triggers on candle BODY CLOSE beyond Leg B; invalidation
//       triggers on WICK/GAP beyond Leg A.
//   Q4  Only the ACTIVE structure is drawn; on freeze its drawings are deleted,
//       data is retained in the immutable object.
//   Leg B two-stage (user rule) with Option A (step-down / sticky):
//       Candidate Leg B = current extreme confirmed fractal of the active leg.
//       Validated Leg B = Candidate promoted once an OPPOSITE confirmed fractal
//                         forms AFTER it (a completed swing). Validated Leg B
//                         only steps DOWN (sell) / UP (buy) through completed
//                         swings and STAYS until a newer extreme is itself
//                         validated. ONLY Validated Leg B triggers continuation.
//
// PER-CANDLE EVENT PRIORITY (never changes):
//   1. Invalidation  2. Completion  3. BOS Candidate Detection
//   4. Fractal / Leg-B Updates      5. Drawing Updates
//   Enforced structurally: exactly one FSM branch runs per confirmed bar, and
//   inside the ACTIVE branch invalidation is tested before completion.
//
// MODULES: drawStructure() createStructure() updateLegB() checkInvalidation()
//          checkContinuation() freezeStructure()  + the FSM driver.
// =============================================================================
indicator("Fractal-OGLE-Structure (FOS)", shorttitle = "FOS", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// =============================================================================
// SECTION 0 — INPUTS
// =============================================================================
fractalPeriod = input.int(2, "Fractal Period", minval = 1, maxval = 20, step = 1, group = "Engine", tooltip = "Bill Williams fractal half-width (bars on each side). 2 = classic 5-bar fractal. The whole engine adapts automatically; nothing is hardcoded.")

showFractals = input.bool(false, "Show confirmed fractal markers (aid)", group = "Visuals")
showBosLines = input.bool(true,  "Show BOS line",                          group = "Visuals")
showLegs     = input.bool(true,  "Show Leg A / Validated Leg B lines",     group = "Visuals")
showBox      = input.bool(true,  "Show active structure box",              group = "Visuals")
showLabels   = input.bool(true,  "Show BOS labels",                        group = "Visuals")

debugMode    = input.bool(false, "Debug Mode", group = "Debug", tooltip = "Shows the state table, the Candidate Leg B (dotted line), and a background tint per state.")

colSell    = input.color(color.red,                 "Sell color",     group = "Colors")
colBuy     = input.color(color.green,               "Buy color",      group = "Colors")
colBos     = input.color(color.orange,              "BOS line color", group = "Colors")
colBoxSell = input.color(color.new(color.red,   90),"Sell box fill",  group = "Colors")
colBoxBuy  = input.color(color.new(color.green, 90),"Buy box fill",   group = "Colors")

// =============================================================================
// SECTION 1 — CONSTANTS (explicit FSM states & structure statuses)
// =============================================================================
int STATE_NO_STRUCTURE = 0
int STATE_WAITING      = 1
int STATE_ACTIVE_SELL  = 2
int STATE_ACTIVE_BUY   = 3

int STATUS_ACTIVE      = 0
int STATUS_COMPLETED   = 1
int STATUS_INVALID     = 2

// =============================================================================
// SECTION 2 — FRACTAL ENGINE (configurable period, confirmed only, no repaint)
// -----------------------------------------------------------------------------
// ta.pivothigh(N,N) / ta.pivotlow(N,N) return a value only when the centre bar
// (bar_index - N) is confirmed as a pivot, i.e. N bars later. Changing the
// `fractalPeriod` input immediately re-scales the entire engine.
// =============================================================================
float ph      = ta.pivothigh(fractalPeriod, fractalPeriod)  // confirmed FS-High value (na = none)
float pl      = ta.pivotlow(fractalPeriod, fractalPeriod)   // confirmed FS-Low  value (na = none)
bool  newHigh = not na(ph)                                  // FS-High confirmed on THIS bar
bool  newLow  = not na(pl)                                  // FS-Low  confirmed on THIS bar
int   pivBar  = bar_index - fractalPeriod                   // centre (pivot) bar that just confirmed

// =============================================================================
// SECTION 3 — STRUCTURE OBJECT (immutable once COMPLETED / INVALID)
// =============================================================================
type FosStructure
    int   id                  // unique, incrementing, never reused
    int   dir                 // +1 BUY, -1 SELL
    int   status              // ACTIVE / COMPLETED / INVALID
    float legA                // reversal/invalidation boundary
    int   legABar
    float legBCandidate       // current extreme fractal of the leg (NOT tradeable)
    int   legBCandidateBar
    float legBValidated       // completed-swing Leg B (the ONLY continuation boundary)
    int   legBValidatedBar
    int   bosCandleBar        // the BOS candidate candle
    float bosLevel            // broken boundary level (BOS-line start)
    int   bosLevelBar
    int   confFractalBar      // confirming fractal pivot bar
    int   creationBar
    int   completionBar
    int   invalidationBar
    line  bosLine
    line  legALine
    line  legBLine            // validated Leg B line
    line  legBCandLine        // candidate Leg B line (debug only)
    box   legBox
    label eventLabel

// =============================================================================
// SECTION 4 — MODULE FUNCTIONS
// Pine functions may mutate fields of the object passed in (reference semantics)
// but cannot write module-level `var`s, so global engine state (trackers,
// candidate, FSM state) is driven inline in SECTION 6.
// =============================================================================

// --- drawStructure(): create the on-chart objects for a freshly ACTIVE leg ---
drawStructure(FosStructure s) =>
    col   = s.dir == -1 ? colSell : colBuy
    bxcol = s.dir == -1 ? colBoxSell : colBoxBuy
    if showBosLines
        s.bosLine := line.new(s.bosLevelBar, s.bosLevel, s.bosCandleBar, s.bosLevel, xloc = xloc.bar_index, color = colBos, width = 2)
    if showLabels
        txt = (s.dir == -1 ? "SELL BOS #" : "BUY BOS #") + str.tostring(s.id)
        s.eventLabel := label.new(s.bosCandleBar, s.bosLevel, txt, xloc = xloc.bar_index, style = s.dir == -1 ? label.style_label_down : label.style_label_up, color = col, textcolor = color.white, size = size.small)
    if showLegs
        // Leg A is fixed for the life of the structure -> extend right.
        s.legALine := line.new(s.legABar, s.legA, bar_index, s.legA, xloc = xloc.bar_index, color = col, width = 1, style = line.style_dashed, extend = extend.right)
    if showBox
        // Box envelope spans Leg A to the current extreme (candidate).
        top = math.max(s.legA, s.legBCandidate)
        bot = math.min(s.legA, s.legBCandidate)
        s.legBox := box.new(math.min(s.legABar, s.legBCandidateBar), top, bar_index, bot, xloc = xloc.bar_index, border_color = col, bgcolor = bxcol)
    s

// --- createStructure(): build a new ACTIVE structure object -------------------
createStructure(int dir, float legA, int legABar, float legBCand, int legBCandBar, int bosBar, float bosLevel, int bosLevelBar, int confBar, int id) =>
    s = FosStructure.new()
    s.id               := id
    s.dir              := dir
    s.status           := STATUS_ACTIVE
    s.legA             := legA
    s.legABar          := legABar
    s.legBCandidate    := legBCand      // the confirming fractal starts as CANDIDATE only
    s.legBCandidateBar := legBCandBar
    s.legBValidated    := na            // no validated Leg B yet -> continuation disabled
    s.legBValidatedBar := na
    s.bosCandleBar     := bosBar
    s.bosLevel         := bosLevel
    s.bosLevelBar      := bosLevelBar
    s.confFractalBar   := confBar
    s.creationBar      := bar_index
    s.completionBar    := na
    s.invalidationBar  := na
    drawStructure(s)
    s

// --- updateLegB(): two-stage Leg B (Candidate -> Validated) + drawing ---------
// Candidate updates on a new extreme in the leg direction. Validation promotes
// the candidate the first time an OPPOSITE confirmed fractal forms after it
// (a completed swing). Option A: Validated Leg B is sticky and only steps in
// the leg direction as newer extremes get validated.
updateLegB(FosStructure s) =>
    // Stage 1 — Candidate update (new extreme).
    if s.dir == -1 and newLow and pl < s.legBCandidate
        s.legBCandidate    := pl
        s.legBCandidateBar := pivBar
    if s.dir == 1 and newHigh and ph > s.legBCandidate
        s.legBCandidate    := ph
        s.legBCandidateBar := pivBar
    // Stage 2 — Validation (opposite fractal forms AFTER the current candidate).
    if s.dir == -1 and newHigh and pivBar > s.legBCandidateBar
        s.legBValidated    := s.legBCandidate
        s.legBValidatedBar := s.legBCandidateBar
    if s.dir == 1 and newLow and pivBar > s.legBCandidateBar
        s.legBValidated    := s.legBCandidate
        s.legBValidatedBar := s.legBCandidateBar
    // Drawing — validated Leg B (solid, tradeable boundary).
    col = s.dir == -1 ? colSell : colBuy
    if showLegs and not na(s.legBValidated)
        if na(s.legBLine)
            s.legBLine := line.new(s.legBValidatedBar, s.legBValidated, bar_index, s.legBValidated, xloc = xloc.bar_index, color = col, width = 2, extend = extend.right)
        else
            line.set_xy1(s.legBLine, s.legBValidatedBar, s.legBValidated)
            line.set_xy2(s.legBLine, bar_index, s.legBValidated)
    // Drawing — candidate Leg B (dotted, debug only, NOT tradeable).
    if debugMode
        if na(s.legBCandLine)
            s.legBCandLine := line.new(s.legBCandidateBar, s.legBCandidate, bar_index, s.legBCandidate, xloc = xloc.bar_index, color = color.new(col, 40), width = 1, style = line.style_dotted, extend = extend.right)
        else
            line.set_xy1(s.legBCandLine, s.legBCandidateBar, s.legBCandidate)
            line.set_xy2(s.legBCandLine, bar_index, s.legBCandidate)
    // Drawing — box envelope follows the candidate extreme.
    if not na(s.legBox)
        box.set_top(s.legBox, math.max(s.legA, s.legBCandidate))
        box.set_bottom(s.legBox, math.min(s.legA, s.legBCandidate))
    s

// --- checkInvalidation(): Leg A violated by WICK or GAP (Q1 / Rule 9) ---------
checkInvalidation(FosStructure s) =>
    s.dir == -1 ? high > s.legA : low < s.legA

// --- checkContinuation(): body CLOSE beyond the VALIDATED Leg B (Q3) ----------
checkContinuation(FosStructure s) =>
    not na(s.legBValidated) and (s.dir == -1 ? close < s.legBValidated : close > s.legBValidated)

// --- freezeStructure(): mark immutable + remove drawings (Q4) ------------------
freezeStructure(FosStructure s, int newStatus, int barIdx) =>
    s.status := newStatus
    if newStatus == STATUS_COMPLETED
        s.completionBar := barIdx
    else
        s.invalidationBar := barIdx
    if not na(s.bosLine)
        line.delete(s.bosLine)
    if not na(s.legALine)
        line.delete(s.legALine)
    if not na(s.legBLine)
        line.delete(s.legBLine)
    if not na(s.legBCandLine)
        line.delete(s.legBCandLine)
    if not na(s.legBox)
        box.delete(s.legBox)
    if not na(s.eventLabel)
        label.delete(s.eventLabel)
    s

// =============================================================================
// SECTION 5 — PERSISTENT ENGINE STATE
// =============================================================================
// Running "latest confirmed fractal" trackers.
var float lastHigh    = na
var int   lastHighBar = na
var float lastLow     = na
var int   lastLowBar  = na

// Pending BOS Candidate (exists ONLY in NO_STRUCTURE/WAITING — Rule 5).
var int   candDir      = 0     // 0 none, +1 buy, -1 sell
var int   candBar      = na
var float candLevel    = na
var int   candLevelBar = na
var float candLegA     = na
var int   candLegABar  = na

// Structure store + active pointer + ID counter + explicit FSM state.
var array<FosStructure> structures = array.new<FosStructure>()
var FosStructure        active     = na
var int                 nextId     = 1
var int                 st         = STATE_NO_STRUCTURE

// =============================================================================
// SECTION 6 — FSM DRIVER (confirmed bars only => never repaints)
// Exactly ONE state branch runs per bar; that structurally enforces the event
// priority and Rule 6 (an invalidation candle can never seed a candidate).
// =============================================================================
if barstate.isconfirmed

    // (Priority 4a) Update latest-confirmed fractal trackers first, so detection
    // and Leg A snapshots see the newest fractal that precedes the current close.
    if newHigh
        lastHigh    := ph
        lastHighBar := pivBar
    if newLow
        lastLow    := pl
        lastLowBar := pivBar

    // Optional confirmed-fractal markers (development aid; off by default so
    // internal fractals are not drawn during an active structure — Rule 11).
    if showFractals and newHigh
        label.new(pivBar, ph, "H", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(colSell, 40), textcolor = color.white, size = size.tiny)
    if showFractals and newLow
        label.new(pivBar, pl, "L", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(colBuy, 40), textcolor = color.white, size = size.tiny)

    // -------------------------------------------------------------------------
    if st == STATE_ACTIVE_SELL or st == STATE_ACTIVE_BUY
        // ===== ACTIVE structure: structure locked; only Leg A / Leg B matter ==

        // (Priority 1) Invalidation — Leg A violated by wick/gap.
        if checkInvalidation(active)
            freezeStructure(active, STATUS_INVALID, bar_index)
            active := na
            st     := STATE_NO_STRUCTURE
            // Rule 6: this candle does NOT seed a candidate (no detection runs).

        // (Priority 2) Completion — body close beyond the VALIDATED Leg B.
        else if checkContinuation(active)
            int   d         = active.dir
            float bLevel    = active.legBValidated
            int   bLevelBar = active.legBValidatedBar
            freezeStructure(active, STATUS_COMPLETED, bar_index)
            active := na
            // Freeze-then-seed (Q2): the SAME break candle becomes the new
            // same-direction BOS Candidate; Leg A = latest confirmed opposite fractal.
            candDir      := d
            candBar      := bar_index
            candLevel    := bLevel
            candLevelBar := bLevelBar
            if d == -1
                candLegA    := lastHigh
                candLegABar := lastHighBar
            else
                candLegA    := lastLow
                candLegABar := lastLowBar
            st := STATE_WAITING

        // (Priority 4b) Otherwise: update Leg B (candidate + validation) & grow box.
        else
            updateLegB(active)
            if not na(active.legBox)
                box.set_right(active.legBox, bar_index)

    // -------------------------------------------------------------------------
    else if st == STATE_WAITING
        // ===== Candidate pending: wait for confirmation; opposite cancels ======

        // (Confirmation) Sell -> first FS-Low after candidate; Buy -> first FS-High.
        if candDir == -1 and newLow and pivBar > candBar
            s = createStructure(-1, candLegA, candLegABar, pl, pivBar, candBar, candLevel, candLevelBar, pivBar, nextId)
            array.push(structures, s)
            active := s
            nextId := nextId + 1
            candDir := 0
            st     := STATE_ACTIVE_SELL
        else if candDir == 1 and newHigh and pivBar > candBar
            s = createStructure(1, candLegA, candLegABar, ph, pivBar, candBar, candLevel, candLevelBar, pivBar, nextId)
            array.push(structures, s)
            active := s
            nextId := nextId + 1
            candDir := 0
            st     := STATE_ACTIVE_BUY
        else
            // (Priority 3) Opposite-candidate cancellation (body close only).
            bool detBuy  = not na(lastHigh) and close > lastHigh
            bool detSell = not na(lastLow)  and close < lastLow
            if candDir == -1 and detBuy and not na(lastLow)
                candDir      := 1
                candBar      := bar_index
                candLevel    := lastHigh
                candLevelBar := lastHighBar
                candLegA     := lastLow
                candLegABar  := lastLowBar
            else if candDir == 1 and detSell and not na(lastHigh)
                candDir      := -1
                candBar      := bar_index
                candLevel    := lastLow
                candLevelBar := lastLowBar
                candLegA     := lastHigh
                candLegABar  := lastHighBar

    // -------------------------------------------------------------------------
    else
        // ===== STATE_NO_STRUCTURE: hunt a fresh BOS candidate =================
        // (Priority 3) Body close beyond the latest confirmed fractal. A sell
        // needs an FS-High for Leg A (and vice-versa); otherwise wait.
        bool detBuy  = not na(lastHigh) and close > lastHigh
        bool detSell = not na(lastLow)  and close < lastLow
        if detSell and not na(lastHigh)
            candDir      := -1
            candBar      := bar_index
            candLevel    := lastLow
            candLevelBar := lastLowBar
            candLegA     := lastHigh
            candLegABar  := lastHighBar
            st           := STATE_WAITING
        else if detBuy and not na(lastLow)
            candDir      := 1
            candBar      := bar_index
            candLevel    := lastHigh
            candLevelBar := lastHighBar
            candLegA     := lastLow
            candLegABar  := lastLowBar
            st           := STATE_WAITING

// =============================================================================
// SECTION 7 — DEBUG (Priority 5: drawing) — shown only when Debug Mode = ON
// =============================================================================
bgcolor(debugMode ? (st == STATE_ACTIVE_SELL ? color.new(color.red, 92) : st == STATE_ACTIVE_BUY ? color.new(color.green, 92) : st == STATE_WAITING ? color.new(color.yellow, 93) : na) : na)

var table dbg = table.new(position.top_right, 2, 9, border_width = 1)
if debugMode and barstate.islast
    string stName   = st == STATE_NO_STRUCTURE ? "NO_STRUCTURE" : st == STATE_WAITING ? "WAITING_FOR_CONFIRMATION" : st == STATE_ACTIVE_SELL ? "ACTIVE_SELL" : "ACTIVE_BUY"
    string idStr    = na(active) ? "-" : str.tostring(active.id)
    string legAStr  = na(active) ? "-" : str.tostring(active.legA, format.mintick)
    string legBvStr = na(active) ? "-" : na(active.legBValidated) ? "-" : str.tostring(active.legBValidated, format.mintick)
    string legBcStr = na(active) ? "-" : str.tostring(active.legBCandidate, format.mintick)
    string candStr  = candDir == 0 ? "none" : (candDir == -1 ? "SELL @ " : "BUY @ ") + str.tostring(candLevel, format.mintick)
    string hiStr    = na(lastHigh) ? "-" : str.tostring(lastHigh, format.mintick)
    string loStr    = na(lastLow)  ? "-" : str.tostring(lastLow,  format.mintick)

    table.cell(dbg, 0, 0, "FOS — DEBUG",     text_color = color.white, bgcolor = color.new(color.blue, 10), text_size = size.small)
    table.cell(dbg, 1, 0, "state machine",   text_color = color.white, bgcolor = color.new(color.blue, 10), text_size = size.small)
    table.cell(dbg, 0, 1, "State",           text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(dbg, 1, 1, stName,            text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(dbg, 0, 2, "Structure ID",    text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dbg, 1, 2, idStr,             text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dbg, 0, 3, "Leg A",           text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(dbg, 1, 3, legAStr,           text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(dbg, 0, 4, "Leg B (valid)",   text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dbg, 1, 4, legBvStr,          text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dbg, 0, 5, "Leg B (cand)",    text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(dbg, 1, 5, legBcStr,          text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(dbg, 0, 6, "BOS Candidate",   text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dbg, 1, 6, candStr,           text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dbg, 0, 7, "Last FS-High",    text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(dbg, 1, 7, hiStr,             text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(dbg, 0, 8, "Last FS-Low",     text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(dbg, 1, 8, loStr,             text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
