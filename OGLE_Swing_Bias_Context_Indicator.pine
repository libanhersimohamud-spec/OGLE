//@version=6
indicator("OGLE Swing Bias Context - HTF Direction", overlay=true, max_labels_count=500, max_lines_count=500)

// =====================
// INPUTS
// =====================
groupSymbol = "1. Symbol"
groupTF = "2. Timeframes"
groupTable = "3. Table"
groupVisuals = "4. Visuals"

useChartSymbol = input.bool(true, "Use Chart Symbol", group=groupSymbol)
selectedSymbol = input.symbol("FX:EURUSD", "Selected Pair", group=groupSymbol)
modelSymbol = useChartSymbol ? syminfo.tickerid : selectedSymbol

biasTF1 = input.timeframe("12M", "Bias TF 1", group=groupTF)
biasTF2 = input.timeframe("6M", "Bias TF 2", group=groupTF)
biasTF3 = input.timeframe("4M", "Bias TF 3", group=groupTF)
biasTF4 = input.timeframe("3M", "Bias TF 4", group=groupTF)
biasTF5 = input.timeframe("2M", "Bias TF 5", group=groupTF)
biasTF6 = input.timeframe("M", "Bias TF 6", group=groupTF)

// Confirmation Layer 1 (CL1) — only two timeframes: 1W and 2W
layer1TFA = input.timeframe("W", "Confirmation CL1-A (1W)", group=groupTF)
layer1TFB = input.timeframe("2W", "Confirmation CL1-B (2W)", group=groupTF)

// Confirmation Layer 2 (CL2) — only two timeframes: 1D and 2D
layer2TFA = input.timeframe("D", "Confirmation CL2-A (1D)", group=groupTF)
layer2TFB = input.timeframe("2D", "Confirmation CL2-B (2D)", group=groupTF)

// Primary structural reference (used by the daily candle sweep / opposing
// candle checks below)
layer2TF = layer2TFA

showTable = input.bool(true, "Show Context Table", group=groupTable)

tableTextSizeInput = input.string(
     "Tiny",
     "Table Text Size",
     options=["Tiny", "Small", "Normal"],
     group=groupTable
)

tableTextSize =
     tableTextSizeInput == "Tiny" ? size.tiny :
     tableTextSizeInput == "Small" ? size.small :
     size.normal

buyColor = input.color(color.green, "Buy Color", group=groupVisuals)
sellColor = input.color(color.red, "Sell Color", group=groupVisuals)
neutralColor = input.color(color.new(color.black, 10), "Neutral Color", group=groupVisuals)
showTargetLines = input.bool(true, "Show Target Lines", group=groupVisuals)

// =====================
// PATTERNS
// =====================
f_bodyCloseBuy() =>
    close[1] > high[2]

f_bodyCloseSell() =>
    close[1] < low[2]

f_decisiveBuy() =>
    low[1] < low[2] and high[1] > high[2] and close[1] > open[1]

f_decisiveSell() =>
    high[1] > high[2] and low[1] < low[2] and close[1] < open[1]

f_bsbBuy() =>
    close[2] > open[2] and high[1] <= high[2] and low[1] >= low[2]

f_sbsSell() =>
    close[2] < open[2] and high[1] <= high[2] and low[1] >= low[2]

f_threeDPBuy() =>
    close[1] >= low[2] and close[1] <= high[2] and low < low[1] and low < low[2]

f_threeDPSell() =>
    close[1] >= low[2] and close[1] <= high[2] and high > high[1] and high > high[2]

f_dsBuy() =>
    close[1] < low[2] and close[1] < low[3] and
     close[2] >= low[1] and close[2] >= low[2] and close[2] >= low[3] and
     low < low[1]

f_dsSell() =>
    close[1] > high[2] and close[1] > high[3] and
     close[2] <= high[1] and close[2] <= high[2] and close[2] <= high[3] and
     high > high[1]

f_near3DPBuy() =>
    high[1] <= high[2] and low[1] >= low[2] and low < low[1] and low < low[2]

f_near3DPSell() =>
    high[1] <= high[2] and low[1] >= low[2] and high > high[1] and high > high[2]

f_nearDSBuy() =>
    high[2] <= high[3] and low[2] >= low[3] and
     close[1] < low[2] and close[1] < low[3] and
     low < low[1] and low < low[2] and low < low[3] and
     high[2] <= high[3] and high[1] <= high[3] and high <= high[3]

f_nearDSSell() =>
    high[2] <= high[3] and low[2] >= low[3] and
     close[1] > high[2] and close[1] > high[3] and
     high > high[1] and high > high[2] and high > high[3] and
     low[2] >= low[3] and low[1] >= low[3] and low >= low[3]

f_buyPatternText() =>
    string txt = ""
    txt := f_bodyCloseBuy() ? txt + "BC " : txt
    txt := f_decisiveBuy() ? txt + "DC " : txt
    txt := f_bsbBuy() ? txt + "BSB " : txt
    txt := f_threeDPBuy() ? txt + "3DP " : txt
    txt := f_dsBuy() ? txt + "3DP-DS " : txt
    txt := f_near3DPBuy() ? txt + "N-3DP " : txt
    txt := f_nearDSBuy() ? txt + "N-DS " : txt
    txt == "" ? "-" : txt

f_sellPatternText() =>
    string txt = ""
    txt := f_bodyCloseSell() ? txt + "BC " : txt
    txt := f_decisiveSell() ? txt + "DC " : txt
    txt := f_sbsSell() ? txt + "SBS " : txt
    txt := f_threeDPSell() ? txt + "3DP " : txt
    txt := f_dsSell() ? txt + "3DP-DS " : txt
    txt := f_near3DPSell() ? txt + "N-3DP " : txt
    txt := f_nearDSSell() ? txt + "N-DS " : txt
    txt == "" ? "-" : txt

f_patternPack() =>
    [f_buyPatternText(), f_sellPatternText()]

// =====================
// HTF BIAS SCANS
// =====================
[buyB1, sellB1] =
     request.security(modelSymbol, biasTF1, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

[buyB2, sellB2] =
     request.security(modelSymbol, biasTF2, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

[buyB3, sellB3] =
     request.security(modelSymbol, biasTF3, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

[buyB4, sellB4] =
     request.security(modelSymbol, biasTF4, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

[buyB5, sellB5] =
     request.security(modelSymbol, biasTF5, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

[buyB6, sellB6] =
     request.security(modelSymbol, biasTF6, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

// =====================
// CONFIRMATION LAYER SCANS (CL1: 1W/2W, CL2: 1D/2D)
// =====================
[buyL1A, sellL1A] =
     request.security(modelSymbol, layer1TFA, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

[buyL1B, sellL1B] =
     request.security(modelSymbol, layer1TFB, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

[buyL2ARaw, sellL2ARaw] =
     request.security(modelSymbol, layer2TFA, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

[buyL2BRaw, sellL2BRaw] =
     request.security(modelSymbol, layer2TFB, f_patternPack(), barmerge.gaps_off, barmerge.lookahead_off)

// Collapse the two CL1 timeframes into a single "any confirmation found" var
// (used by the route logic below — CL1-A takes priority).
buyL1 =
     buyL1A != "-" ? buyL1A :
     buyL1B != "-" ? buyL1B :
     "-"

sellL1 =
     sellL1A != "-" ? sellL1A :
     sellL1B != "-" ? sellL1B :
     "-"

buyL2Raw = buyL2ARaw != "-" ? buyL2ARaw : buyL2BRaw
sellL2Raw = sellL2ARaw != "-" ? sellL2ARaw : sellL2BRaw

// Daily (CL2-A) candle-sweep reference: current vs previous daily candle
// high/low (used for the opposing-candle quality filter below), and the
// previous daily candle's close vs the candle-2-back high/low (used to
// detect an "opposing" confirmation candle).
[dailyC0High, dailyC0Low, dailyC1High, dailyC1Low, dailyC1Close, dailyC2High, dailyC2Low] =
     request.security(modelSymbol, layer2TF, [high, low, high[1], low[1], close[1], high[2], low[2]], barmerge.gaps_off, barmerge.lookahead_off)

// Previous completed CL1 candle high/low (Candle 1 = last fully closed candle
// on that timeframe, never Candle 0 / the currently forming one). Used for
// the initial structural target below.
[prevCL1AHigh, prevCL1ALow] =
     request.security(modelSymbol, layer1TFA, [high[1], low[1]], barmerge.gaps_off, barmerge.lookahead_off)

[prevCL1BHigh, prevCL1BLow] =
     request.security(modelSymbol, layer1TFB, [high[1], low[1]], barmerge.gaps_off, barmerge.lookahead_off)

// Previous completed CL2 candle high/low (Candle 1, same rule as above).
// Used both as the promoted target level and as the Layer-2 invalidation
// trigger level.
[prevCL2AHigh, prevCL2ALow] =
     request.security(modelSymbol, layer2TFA, [high[1], low[1]], barmerge.gaps_off, barmerge.lookahead_off)

[prevCL2BHigh, prevCL2BLow] =
     request.security(modelSymbol, layer2TFB, [high[1], low[1]], barmerge.gaps_off, barmerge.lookahead_off)

// =====================
// CONFIRMATION LOGIC
// =====================
dailyC0TookC1High = dailyC0High > dailyC1High
dailyC0TookC1Low = dailyC0Low < dailyC1Low

dailySellOpposingC1 = dailyC1Close > dailyC2High
dailyBuyOpposingC1 = dailyC1Close < dailyC2Low

dailySellOpposingCleared = dailyC0TookC1High
dailyBuyOpposingCleared = dailyC0TookC1Low

buyLayer2OKRaw = buyL2Raw != "-"
sellLayer2OKRaw = sellL2Raw != "-"

buyLayer2OK =
     buyLayer2OKRaw and
     (not dailyBuyOpposingC1 or dailyBuyOpposingCleared)

sellLayer2OK =
     sellLayer2OKRaw and
     (not dailySellOpposingC1 or dailySellOpposingCleared)

buyBiasOK = buyB1 != "-" or buyB2 != "-" or buyB3 != "-" or buyB4 != "-" or buyB5 != "-" or buyB6 != "-"
sellBiasOK = sellB1 != "-" or sellB2 != "-" or sellB3 != "-" or sellB4 != "-" or sellB5 != "-" or sellB6 != "-"

buyLayer1OK = buyL1 != "-"
sellLayer1OK = sellL1 != "-"

// =====================
// ROUTES
// =====================
buyHTFOK = buyBiasOK and buyLayer1OK and buyLayer2OK
sellHTFOK = sellBiasOK and sellLayer1OK and sellLayer2OK

// =====================
// CL1 -> CL2 PATH VALIDATION
// -----------------------------------------------------------------------
// Only three Bias -> CL1 -> CL2 sequences are ever accepted:
//   Path 1: CL1-A (1W) -> CL2-A (1D)
//   Path 2: CL1-B (2W) -> CL2-B (2D)
//   Path 3: CL1-A (1W) -> CL2-B (2D)
// CL1-B (2W) -> CL2-A (1D) is never a valid path and is excluded by
// construction (it does not appear in any of the three OR terms below).
// =====================
cl1ABuyFound = buyL1A != "-"
cl1ASellFound = sellL1A != "-"
cl1BBuyFound = buyL1B != "-"
cl1BSellFound = sellL1B != "-"

cl2ABuyFound = buyL2ARaw != "-"
cl2ASellFound = sellL2ARaw != "-"
cl2BBuyFound = buyL2BRaw != "-"
cl2BSellFound = sellL2BRaw != "-"

buyPath1 = cl1ABuyFound and cl2ABuyFound   // 1W -> 1D
buyPath2 = cl1BBuyFound and cl2BBuyFound   // 2W -> 2D
buyPath3 = cl1ABuyFound and cl2BBuyFound   // 1W -> 2D

sellPath1 = cl1ASellFound and cl2ASellFound   // 1W -> 1D
sellPath2 = cl1BSellFound and cl2BSellFound   // 2W -> 2D
sellPath3 = cl1ASellFound and cl2BSellFound   // 1W -> 2D

buyPathValid = buyPath1 or buyPath2 or buyPath3
sellPathValid = sellPath1 or sellPath2 or sellPath3

// Which CL1 timeframe actually generated the accepted setup (drives the
// structural target below). Path 1 and Path 3 are both generated by CL1-A.
generatingCL1Buy =
     (buyPath1 or buyPath3) ? "1W" :
     buyPath2 ? "2W" :
     "-"

generatingCL1Sell =
     (sellPath1 or sellPath3) ? "1W" :
     sellPath2 ? "2W" :
     "-"

// Which CL2 timeframe is active for a freshly-detected path. Path 1 uses
// CL2-A (1D); Path 2 and Path 3 both use CL2-B (2D). This is the timeframe
// that controls target progression and setup invalidation (see below).
activeCL2Buy =
     buyPath1 ? "1D" :
     (buyPath2 or buyPath3) ? "2D" :
     "-"

activeCL2Sell =
     sellPath1 ? "1D" :
     (sellPath2 or sellPath3) ? "2D" :
     "-"

// Fresh (bar-close) edges on each CL2 leg — used to detect "the next valid
// Daily / 2-Day confirmation candle" that lifts a Layer-2 invalidation lockout.
cl2ABuyFoundNew = cl2ABuyFound and not cl2ABuyFound[1]
cl2ASellFoundNew = cl2ASellFound and not cl2ASellFound[1]
cl2BBuyFoundNew = cl2BBuyFound and not cl2BBuyFound[1]
cl2BSellFoundNew = cl2BSellFound and not cl2BSellFound[1]

// =====================
// FINAL MODEL
// -----------------------------------------------------------------------
// The CL1->CL2 path validity is applied as a final gate so the forbidden
// CL1-B(2W) -> CL2-A(1D) sequence can never produce a signal.
// =====================
buyModelOK = buyHTFOK and buyPathValid
sellModelOK = sellHTFOK and sellPathValid

finalDirection =
     buyModelOK and not sellModelOK ? "BUY" :
     sellModelOK and not buyModelOK ? "SELL" :
     buyModelOK and sellModelOK ? "BOTH" :
     "WAIT"

contextColor =
     finalDirection == "BUY" ? buyColor :
     finalDirection == "SELL" ? sellColor :
     finalDirection == "BOTH" ? color.orange :
     neutralColor

// =====================
// DYNAMIC MULTI-LEVEL TARGET + LAYER-2 INVALIDATION
// -----------------------------------------------------------------------
// Each accepted setup is a persistent state (not just a per-bar recompute):
//   - Initial target = the CL1 candle-1 high/low (1W or 2W, whichever
//     generated the setup), captured ONCE at setup creation.
//   - The active CL2 candle-1 high/low (1D if the path used CL2-A, 2D if it
//     used CL2-B) is ALSO captured once at setup creation and held fixed —
//     it serves both as the invalidation trigger and, once the initial
//     target is broken, as the PROMOTED target (a single, one-time swap).
//   - Every price level is therefore a fixed, static anchor: it is
//     calculated once from Candle 1 (the last fully closed candle on that
//     timeframe, never Candle 0) at the moment it becomes relevant, and is
//     never re-read or moved afterward. Only the line's right edge (x2) and
//     the label's x-position grow forward each bar so the line visibly
//     reaches the current candle — the price (y) never changes except when
//     a promotion or a brand-new setup legitimately replaces it.
// =====================
buyNewSetupEdge = buyModelOK and not buyModelOK[1]
sellNewSetupEdge = sellModelOK and not sellModelOK[1]

var bool buySetupActive = false
var bool buyLockedOut = false
var string buyLockoutCL2 = na
var string buyActiveCL1 = na
var string buyActiveCL2 = na
var float buyActiveCL2Level = na
var float buyActiveTargetLevel = na
var bool buyTargetPromoted = false
var line buyActiveLine = na
var label buyActiveLabel = na
var array<line> buyTargetLines = array.new<line>()
var array<label> buyTargetLabels = array.new<label>()

var bool sellSetupActive = false
var bool sellLockedOut = false
var string sellLockoutCL2 = na
var string sellActiveCL1 = na
var string sellActiveCL2 = na
var float sellActiveCL2Level = na
var float sellActiveTargetLevel = na
var bool sellTargetPromoted = false
var line sellActiveLine = na
var label sellActiveLabel = na
var array<line> sellTargetLines = array.new<line>()
var array<label> sellTargetLabels = array.new<label>()

f_pushTarget(_lines, _labels, _price, _col) =>
    if array.size(_lines) >= 2
        line.delete(array.shift(_lines))
        label.delete(array.shift(_labels))
    newLine = line.new(bar_index, _price, bar_index + 1, _price, xloc=xloc.bar_index, color=_col, width=1, style=line.style_solid, extend=extend.none)
    newLabel = label.new(bar_index, _price, text="Target", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(_col, 20), textcolor=color.white, size=size.small)
    array.push(_lines, newLine)
    array.push(_labels, newLabel)
    [newLine, newLabel]

if barstate.isconfirmed
    // ---------------- BUY SIDE ----------------
    if buyLockedOut and ((buyLockoutCL2 == "1D" and cl2ABuyFoundNew) or (buyLockoutCL2 == "2D" and cl2BBuyFoundNew))
        buyLockedOut := false
        buyLockoutCL2 := na

    if buySetupActive
        // Grow the active line/label to the current bar. The price (y) is
        // never touched here — it stays fixed at whatever it was set to on
        // creation or at the last promotion.
        if not na(buyActiveLine)
            line.set_x2(buyActiveLine, bar_index)
        if not na(buyActiveLabel)
            label.set_x(buyActiveLabel, bar_index)

        if high > buyActiveCL2Level
            buySetupActive := false
            buyLockedOut := true
            buyLockoutCL2 := buyActiveCL2
            buyActiveLine := na
            buyActiveLabel := na
            buyActiveTargetLevel := na
            buyActiveCL2Level := na
            buyTargetPromoted := false
            buyActiveCL1 := na
            buyActiveCL2 := na
        else if not buyTargetPromoted and high > buyActiveTargetLevel
            if showTargetLines
                [nl, nlab] = f_pushTarget(buyTargetLines, buyTargetLabels, buyActiveCL2Level, buyColor)
                buyActiveLine := nl
                buyActiveLabel := nlab
            buyActiveTargetLevel := buyActiveCL2Level
            buyTargetPromoted := true

    if not buyLockedOut and not buySetupActive and buyNewSetupEdge
        buyInitialLevel = generatingCL1Buy == "1W" ? prevCL1AHigh : generatingCL1Buy == "2W" ? prevCL1BHigh : na
        buyInitialCL2Level = activeCL2Buy == "1D" ? prevCL2AHigh : activeCL2Buy == "2D" ? prevCL2BHigh : na
        if not na(buyInitialLevel) and not na(buyInitialCL2Level)
            buyActiveCL1 := generatingCL1Buy
            buyActiveCL2 := activeCL2Buy
            buyActiveCL2Level := buyInitialCL2Level
            buyActiveTargetLevel := buyInitialLevel
            buyTargetPromoted := false
            buySetupActive := true
            if showTargetLines
                [nl2, nlab2] = f_pushTarget(buyTargetLines, buyTargetLabels, buyInitialLevel, buyColor)
                buyActiveLine := nl2
                buyActiveLabel := nlab2

    // ---------------- SELL SIDE (mirror) ----------------
    if sellLockedOut and ((sellLockoutCL2 == "1D" and cl2ASellFoundNew) or (sellLockoutCL2 == "2D" and cl2BSellFoundNew))
        sellLockedOut := false
        sellLockoutCL2 := na

    if sellSetupActive
        if not na(sellActiveLine)
            line.set_x2(sellActiveLine, bar_index)
        if not na(sellActiveLabel)
            label.set_x(sellActiveLabel, bar_index)

        if low < sellActiveCL2Level
            sellSetupActive := false
            sellLockedOut := true
            sellLockoutCL2 := sellActiveCL2
            sellActiveLine := na
            sellActiveLabel := na
            sellActiveTargetLevel := na
            sellActiveCL2Level := na
            sellTargetPromoted := false
            sellActiveCL1 := na
            sellActiveCL2 := na
        else if not sellTargetPromoted and low < sellActiveTargetLevel
            if showTargetLines
                [nl3, nlab3] = f_pushTarget(sellTargetLines, sellTargetLabels, sellActiveCL2Level, sellColor)
                sellActiveLine := nl3
                sellActiveLabel := nlab3
            sellActiveTargetLevel := sellActiveCL2Level
            sellTargetPromoted := true

    if not sellLockedOut and not sellSetupActive and sellNewSetupEdge
        sellInitialLevel = generatingCL1Sell == "1W" ? prevCL1ALow : generatingCL1Sell == "2W" ? prevCL1BLow : na
        sellInitialCL2Level = activeCL2Sell == "1D" ? prevCL2ALow : activeCL2Sell == "2D" ? prevCL2BLow : na
        if not na(sellInitialLevel) and not na(sellInitialCL2Level)
            sellActiveCL1 := generatingCL1Sell
            sellActiveCL2 := activeCL2Sell
            sellActiveCL2Level := sellInitialCL2Level
            sellActiveTargetLevel := sellInitialLevel
            sellTargetPromoted := false
            sellSetupActive := true
            if showTargetLines
                [nl4, nlab4] = f_pushTarget(sellTargetLines, sellTargetLabels, sellInitialLevel, sellColor)
                sellActiveLine := nl4
                sellActiveLabel := nlab4

// =====================
// CLEAN INFO TEXT
// =====================
buyBiasInfo =
     (buyB1 != "-" ? biasTF1 + ": " + buyB1 + " " : "") +
     (buyB2 != "-" ? biasTF2 + ": " + buyB2 + " " : "") +
     (buyB3 != "-" ? biasTF3 + ": " + buyB3 + " " : "") +
     (buyB4 != "-" ? biasTF4 + ": " + buyB4 + " " : "") +
     (buyB5 != "-" ? biasTF5 + ": " + buyB5 + " " : "") +
     (buyB6 != "-" ? biasTF6 + ": " + buyB6 : "")

buyBiasInfo := buyBiasInfo == "" ? "-" : buyBiasInfo

sellBiasInfo =
     (sellB1 != "-" ? biasTF1 + ": " + sellB1 + " " : "") +
     (sellB2 != "-" ? biasTF2 + ": " + sellB2 + " " : "") +
     (sellB3 != "-" ? biasTF3 + ": " + sellB3 + " " : "") +
     (sellB4 != "-" ? biasTF4 + ": " + sellB4 + " " : "") +
     (sellB5 != "-" ? biasTF5 + ": " + sellB5 + " " : "") +
     (sellB6 != "-" ? biasTF6 + ": " + sellB6 : "")

sellBiasInfo := sellBiasInfo == "" ? "-" : sellBiasInfo

buyCL1Info =
     (buyL1A != "-" ? layer1TFA + ": " + buyL1A + " " : "") +
     (buyL1B != "-" ? layer1TFB + ": " + buyL1B : "")

buyCL1Info := buyCL1Info == "" ? "-" : buyCL1Info

sellCL1Info =
     (sellL1A != "-" ? layer1TFA + ": " + sellL1A + " " : "") +
     (sellL1B != "-" ? layer1TFB + ": " + sellL1B : "")

sellCL1Info := sellCL1Info == "" ? "-" : sellCL1Info

buyCL2Info =
     (buyL2ARaw != "-" ? layer2TFA + ": " + buyL2ARaw + " " : "") +
     (buyL2BRaw != "-" ? layer2TFB + ": " + buyL2BRaw : "")

buyCL2Info := buyCL2Info == "" ? "-" : buyCL2Info

sellCL2Info =
     (sellL2ARaw != "-" ? layer2TFA + ": " + sellL2ARaw + " " : "") +
     (sellL2BRaw != "-" ? layer2TFB + ": " + sellL2BRaw : "")

sellCL2Info := sellCL2Info == "" ? "-" : sellCL2Info

buyTargetInfo =
     buyLockedOut ? "LOCKED (" + buyLockoutCL2 + ")" :
     not buySetupActive ? "-" :
     (buyTargetPromoted ? buyActiveCL2 : buyActiveCL1) + " High: " + str.tostring(buyActiveTargetLevel, format.mintick)

sellTargetInfo =
     sellLockedOut ? "LOCKED (" + sellLockoutCL2 + ")" :
     not sellSetupActive ? "-" :
     (sellTargetPromoted ? sellActiveCL2 : sellActiveCL1) + " Low: " + str.tostring(sellActiveTargetLevel, format.mintick)

// =====================
// TABLE
// =====================
var table t = table.new(position.bottom_right, 3, 6, border_width=1)

f_cell(_c, _r, _txt, _bg, _tc) =>
    table.cell(t, _c, _r, _txt, bgcolor=_bg, text_color=_tc, text_size=tableTextSize)

if showTable and barstate.islast
    f_cell(0, 0, "Layer", color.black, color.white)
    f_cell(1, 0, "BUY", buyColor, color.white)
    f_cell(2, 0, "SELL", sellColor, color.white)

    f_cell(0, 1, "Bias", color.black, color.white)
    f_cell(1, 1, buyBiasInfo, buyBiasOK ? buyColor : neutralColor, color.white)
    f_cell(2, 1, sellBiasInfo, sellBiasOK ? sellColor : neutralColor, color.white)

    f_cell(0, 2, "CL1", color.black, color.white)
    f_cell(1, 2, buyCL1Info, buyLayer1OK ? buyColor : neutralColor, color.white)
    f_cell(2, 2, sellCL1Info, sellLayer1OK ? sellColor : neutralColor, color.white)

    f_cell(0, 3, "CL2", color.black, color.white)
    f_cell(1, 3, buyCL2Info, buyLayer2OK ? buyColor : neutralColor, color.white)
    f_cell(2, 3, sellCL2Info, sellLayer2OK ? sellColor : neutralColor, color.white)

    f_cell(0, 4, "Target", color.black, color.white)
    f_cell(1, 4, buyTargetInfo, buyLockedOut ? color.gray : buySetupActive ? buyColor : neutralColor, color.white)
    f_cell(2, 4, sellTargetInfo, sellLockedOut ? color.gray : sellSetupActive ? sellColor : neutralColor, color.white)

    f_cell(0, 5, "Context", color.black, color.white)
    f_cell(1, 5, finalDirection == "BUY" or finalDirection == "BOTH" ? finalDirection : "-", finalDirection == "BUY" or finalDirection == "BOTH" ? buyColor : neutralColor, color.white)
    f_cell(2, 5, finalDirection == "SELL" or finalDirection == "BOTH" ? finalDirection : "-", finalDirection == "SELL" or finalDirection == "BOTH" ? sellColor : neutralColor, color.white)
