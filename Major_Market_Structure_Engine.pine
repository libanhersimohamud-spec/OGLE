//@version=6
// =============================================================================
// Major Market Structure Engine (Bullish & Bearish) — H4 fixed timeframe
//
// Builds and maintains ONE Major Market Structure from a single, fixed structure
// timeframe (default H4 / 240m) no matter which chart timeframe it is applied
// to. The whole engine — confirmed 5-fractals, the N-tier hierarchy, the Major
// Leg, its Fibonacci, Premium/Discount zone and qualifying Fair Value Gap — is
// computed natively at the structure timeframe via request.security() and drawn
// on the chart with time-anchored objects, so you can drop to a lower timeframe
// for entries while the H4 Major Leg stays fixed and clean on screen.
//
// Only the structure timeframe is analysed; no other timeframe is calculated or
// displayed. Only the latest active Major Leg is ever shown. All logic is
// close-based and non-repainting at the structure timeframe (wicks never confirm
// a break or an invalidation), and lookahead is off so nothing is read from the
// future.
// =============================================================================
indicator("Major Market Structure Engine (H4)", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
grpTF = "Structure Timeframe"
// The engine analyses THIS timeframe only. Default H4. Everything is computed at
// this resolution regardless of the chart timeframe; no other timeframe is
// calculated or displayed. Best viewed on the structure timeframe or lower.
structureTF = input.timeframe("240", "Structure Timeframe", group = grpTF, tooltip = "The single timeframe the entire Major Structure is built from. Default 240 (H4). The chart may be lower (e.g. for entries); the H4 structure stays fixed. Using a chart timeframe ABOVE this is not supported.")

grpDisp = "Display"
showLegLines = input.bool(true,  "Leg High / Leg Low",        group = grpDisp)
showFibs     = input.bool(true,  "Fibonacci Levels",          group = grpDisp)
showZone     = input.bool(true,  "Premium / Discount Zone",   group = grpDisp)
showFVG      = input.bool(true,  "Fair Value Gap",            group = grpDisp)
showBOS      = input.bool(true,  "Major BOS Markers",         group = grpDisp)
showSwings   = input.bool(true,  "Swing Structure Points",    group = grpDisp)

grpInit = "Initialization"
// The engine reconstructs only the currently-active Major Leg from a bounded
// window of the most recent structure-timeframe bars (a forward replay of the
// recent window), so it never anchors to obsolete history and starts up fast.
initLookback = input.int(2000, "Reconstruction Window (bars)", minval = 100, maxval = 20000, group = grpInit, tooltip = "How many recent structure-timeframe bars to replay when reconstructing the active Major Leg on load. Larger = safer for long-lived legs, smaller = faster startup.")

grpStruct = "Major Structure"
// Deterministic Major/Minor separation. The Major Leg is anchored to tier
// (depth-1) of a recursive fractal hierarchy: each tier requires the market to
// break the previous tier's confirmed structure, so higher depth = fewer, more
// dominant legs. This is the ONLY selectivity knob and it is structural, not a
// magnitude threshold.
depth = input.int(3, "Structure Depth (tiers)", minval = 1, maxval = 6, group = grpStruct, tooltip = "1 = raw 5-fractals, 2 = swing structure, 3 = major (recommended). 4-5 = HTF-only anchors. Each tier needs one more nested break, filtering minor/internal legs.")
useDisplacement = input.bool(true, "Require Displacement (FVG) on Major BOS", group = grpStruct, tooltip = "A Major BOS only creates a leg if the breaking impulse leaves a Fair Value Gap — an objective footprint of institutional intent. Filters slow, drifty breaks.")
dispLookback    = input.int(3, "Displacement Window (bars)", minval = 1, maxval = 10, group = grpStruct, tooltip = "Bars around the break scanned for a same-direction FVG (the impulse span). Structural, not a magnitude threshold.")

grpCol = "Colors"
bearCol  = input.color(color.red,                       "Bearish",   group = grpCol)
bullCol  = input.color(color.teal,                      "Bullish",   group = grpCol)
fibCol   = input.color(color.new(color.gray, 0),        "Fib Lines", group = grpCol)
zoneCol  = input.color(color.new(color.orange, 82),     "Zone Fill", group = grpCol)
fvgCol   = input.color(color.new(color.blue, 72),       "FVG Fill",  group = grpCol)

// Fractal geometry — 5 left, pivot, 5 right = the 11-candle confirmation window.
LEFT  = 5
RIGHT = 5
MAX_FVG = 300     // hard cap on stored FVGs per active leg (memory guard)
MAX_DEPTH = 6     // hierarchy tier capacity (must be >= the Structure Depth input max)

// -----------------------------------------------------------------------------
// Structure helpers — set a confirmed pivot at a hierarchy tier and roll the
// running branch-extreme that will be promoted to the next tier up. The "b"
// value stored per pivot is its bar TIME (ms), used later for time anchoring.
// -----------------------------------------------------------------------------
setPivotHigh(pvArr, tArr, armArr, runArr, runTArr, k, val, b) =>
    array.set(pvArr, k, val)
    array.set(tArr, k, b)
    array.set(armArr, k, true)
    r = array.get(runArr, k)
    if na(r) or val > r
        array.set(runArr, k, val)
        array.set(runTArr, k, b)

setPivotLow(pvArr, tArr, armArr, runArr, runTArr, k, val, b) =>
    array.set(pvArr, k, val)
    array.set(tArr, k, b)
    array.set(armArr, k, true)
    r = array.get(runArr, k)
    if na(r) or val < r
        array.set(runArr, k, val)
        array.set(runTArr, k, b)

// -----------------------------------------------------------------------------
// msEngine — the WHOLE structure/leg/fib/zone/fvg engine, evaluated natively at
// the structure timeframe (called inside request.security below). It draws
// nothing; it returns the scalar values the chart side needs, with pivot bar
// TIMES so the drawings can be time-anchored onto any chart timeframe.
//
// N-tier fractal hierarchy: one close-break operator applied recursively. Tier 0
// = confirmed 5-fractals. A close beyond tier j's latest pivot is a "break" that
// promotes that tier's running extreme into a pivot of tier j+1. The Major tier
// (depth-1) therefore forms only after `depth` nested breaks, and its break
// (gated by displacement) creates the Major Leg.
// -----------------------------------------------------------------------------
msEngine() =>
    confirmed = barstate.isconfirmed
    inWindow  = bar_index > last_bar_index - initLookback
    top       = depth - 1

    var array<float> pvHigh     = array.new_float(MAX_DEPTH, na)
    var array<int>   pvHighT    = array.new_int(MAX_DEPTH, na)
    var array<float> pvLow      = array.new_float(MAX_DEPTH, na)
    var array<int>   pvLowT     = array.new_int(MAX_DEPTH, na)
    var array<bool>  armHigh    = array.new_bool(MAX_DEPTH, false)
    var array<bool>  armLow     = array.new_bool(MAX_DEPTH, false)
    var array<float> runHigh    = array.new_float(MAX_DEPTH, na)
    var array<int>   runHighT   = array.new_int(MAX_DEPTH, na)
    var array<float> runLow     = array.new_float(MAX_DEPTH, na)
    var array<int>   runLowT    = array.new_int(MAX_DEPTH, na)

    // Tier 0 input — confirmed 5-fractals feed the base of the hierarchy.
    ph = ta.pivothigh(LEFT, RIGHT)
    pl = ta.pivotlow(LEFT, RIGHT)
    if inWindow and not na(ph)
        setPivotHigh(pvHigh, pvHighT, armHigh, runHigh, runHighT, 0, ph, time[RIGHT])
    if inWindow and not na(pl)
        setPivotLow(pvLow, pvLowT, armLow, runLow, runLowT, 0, pl, time[RIGHT])

    // Displacement — same-direction 3-candle FVG in the impulse around this bar.
    bearDisp = false
    bullDisp = false
    if useDisplacement
        for k = 0 to 10
            if k > dispLookback
                break
            if high[k] < low[k + 2]
                bearDisp := true
            if low[k] > high[k + 2]
                bullDisp := true

    // Cascade the break operator up the tiers (lowest first).
    majBearBOS = false
    majBullBOS = false
    newMajSH   = false
    newMajSL   = false
    if inWindow and confirmed
        for j = 0 to MAX_DEPTH - 1
            if j > top
                break
            pvLoj = array.get(pvLow, j)
            pvHij = array.get(pvHigh, j)
            bBear = not na(pvLoj) and array.get(armLow, j)  and close < pvLoj
            bBull = not na(pvHij) and array.get(armHigh, j) and close > pvHij
            if j < top
                if bBear
                    array.set(armLow, j, false)
                    rh = array.get(runHigh, j)
                    if not na(rh)
                        setPivotHigh(pvHigh, pvHighT, armHigh, runHigh, runHighT, j + 1, rh, array.get(runHighT, j))
                        array.set(runHigh, j, na)
                        newMajSH := j + 1 == top ? true : newMajSH
                if bBull
                    array.set(armHigh, j, false)
                    rl = array.get(runLow, j)
                    if not na(rl)
                        setPivotLow(pvLow, pvLowT, armLow, runLow, runLowT, j + 1, rl, array.get(runLowT, j))
                        array.set(runLow, j, na)
                        newMajSL := j + 1 == top ? true : newMajSL
            else
                if bBear and (not useDisplacement or bearDisp)
                    array.set(armLow, j, false)
                    majBearBOS := true
                if bBull and (not useDisplacement or bullDisp)
                    array.set(armHigh, j, false)
                    majBullBOS := true

    // --- Major Leg state (created from the Major tier, gated by displacement) --
    var int   legDir      = 0
    var float legHigh     = na
    var float legLow      = na
    var int   legLeftTime = na
    var bool  touched     = false
    var int   frozenTime  = na

    legCreatedBear = false
    legCreatedBull = false
    legInvalidated = false

    if confirmed and inWindow
        // Invalidation: close beyond the FIXED boundary.
        if legDir == -1 and close > legHigh
            legDir := 0
            legInvalidated := true
        else if legDir == 1 and close < legLow
            legDir := 0
            legInvalidated := true

        // Creation: only when no leg is active, anchored to the Major tier.
        if legDir == 0
            majHi  = array.get(pvHigh, top)
            majLo  = array.get(pvLow, top)
            majHiT = array.get(pvHighT, top)
            majLoT = array.get(pvLowT, top)
            if majBearBOS and not na(majHi) and not na(majLo)
                legDir      := -1
                legHigh     := majHi
                legLow      := majLo
                legLeftTime := majHiT < majLoT ? majHiT : majLoT
                touched     := false
                frozenTime  := na
                legCreatedBear := true
            else if majBullBOS and not na(majHi) and not na(majLo)
                legDir      := 1
                legLow      := majLo
                legHigh     := majHi
                legLeftTime := majHiT < majLoT ? majHiT : majLoT
                touched     := false
                frozenTime  := na
                legCreatedBull := true

        // Dynamic boundary tracks new confirmed MINOR (tier-0) extremes.
        if legDir == -1 and not na(pl) and pl < legLow
            legLow := pl
        if legDir == 1 and not na(ph) and ph > legHigh
            legHigh := ph

    // --- Fibonacci + zone (0.00 = Leg Low, 1.00 = Leg High) -------------------
    float f000 = na
    float f025 = na
    float f050 = na
    float f075 = na
    float f100 = na
    float entry   = na
    float zoneTop = na
    float zoneBot = na
    if legDir != 0
        rng  = legHigh - legLow
        f000 := legLow
        f025 := legLow + rng * 0.25
        f050 := legLow + rng * 0.50
        f075 := legLow + rng * 0.75
        f100 := legHigh
        if legDir == -1
            entry   := f075
            zoneTop := f100
            zoneBot := f075
        else
            entry   := f025
            zoneTop := f025
            zoneBot := f000

    // First-touch of the entry Fib freezes the drawing's right edge (by time).
    if confirmed and inWindow and legDir != 0 and not touched
        if (legDir == -1 and high >= entry) or (legDir == 1 and low <= entry)
            touched    := true
            frozenTime := time

    // --- Fair Value Gaps inside the active leg, largest fully inside the zone --
    var array<float> fvgTop = array.new_float()
    var array<float> fvgBot = array.new_float()
    var array<int>   fvgTyp = array.new_int()
    if legCreatedBear or legCreatedBull
        array.clear(fvgTop)
        array.clear(fvgBot)
        array.clear(fvgTyp)
    if confirmed and inWindow and legDir != 0
        bullFVG = low > high[2]
        bearFVG = high < low[2]
        if bullFVG
            array.push(fvgTop, low)
            array.push(fvgBot, high[2])
            array.push(fvgTyp, 1)
        if bearFVG
            array.push(fvgTop, low[2])
            array.push(fvgBot, high)
            array.push(fvgTyp, -1)
        while array.size(fvgTyp) > MAX_FVG
            array.shift(fvgTop)
            array.shift(fvgBot)
            array.shift(fvgTyp)

    float bestTop = na
    float bestBot = na
    if legDir != 0 and array.size(fvgTyp) > 0
        bestSize = -1.0
        for i = 0 to array.size(fvgTyp) - 1
            if array.get(fvgTyp, i) == legDir
                t = array.get(fvgTop, i)
                b = array.get(fvgBot, i)
                if b >= zoneBot and t <= zoneTop
                    sz = t - b
                    if sz > bestSize
                        bestSize := sz
                        bestTop  := t
                        bestBot  := b

    // Major-tier swing points (for optional SH/SL markers).
    shT = array.get(pvHighT, top)
    shP = array.get(pvHigh, top)
    slT = array.get(pvLowT, top)
    slP = array.get(pvLow, top)

    [legDir, legHigh, legLow, f000, f025, f050, f075, f100, zoneTop, zoneBot, bestTop, bestBot, legLeftTime, frozenTime, majBearBOS, majBullBOS, legCreatedBear, legCreatedBull, legInvalidated, newMajSH, newMajSL, shT, shP, slT, slP]

// -----------------------------------------------------------------------------
// Evaluate the engine at the structure timeframe (lookahead OFF = no future leak).
// -----------------------------------------------------------------------------
[legDir, legHigh, legLow, f000, f025, f050, f075, f100, zoneTop, zoneBot, bestTop, bestBot, legLeftTime, frozenTime, evBearBOS, evBullBOS, evLegBear, evLegBull, evInval, evNewSH, evNewSL, shT, shP, slT, slP] = request.security(syminfo.tickerid, structureTF, msEngine(), lookahead = barmerge.lookahead_off)

// True only on the first chart bar of each new structure-timeframe bar, so
// structure-timeframe events fire exactly once even on a lower chart timeframe.
isNewHTF = ta.change(time(structureTF)) != 0

// -----------------------------------------------------------------------------
// Drawing — one active leg, time-anchored so it maps onto any chart timeframe.
// Objects extend right until first touch (frozenTime), then stay fixed. Handles
// are deleted and rebuilt each bar; all are removed when no leg is active.
// -----------------------------------------------------------------------------
var line  lnHigh = na
var line  lnLow  = na
var line  ln000  = na
var line  ln025  = na
var line  ln050  = na
var line  ln075  = na
var line  ln100  = na
var box   bxZone = na
var box   bxFVG  = na

if not na(lnHigh)
    line.delete(lnHigh)
if not na(lnLow)
    line.delete(lnLow)
if not na(ln000)
    line.delete(ln000)
if not na(ln025)
    line.delete(ln025)
if not na(ln050)
    line.delete(ln050)
if not na(ln075)
    line.delete(ln075)
if not na(ln100)
    line.delete(ln100)
if not na(bxZone)
    box.delete(bxZone)
if not na(bxFVG)
    box.delete(bxFVG)

if legDir != 0 and not na(legLeftTime)
    legCol = legDir == -1 ? bearCol : bullCol
    rEdge  = na(frozenTime) ? time : frozenTime

    if showZone
        bxZone := box.new(legLeftTime, zoneTop, rEdge, zoneBot, xloc = xloc.bar_time, border_color = color.new(legCol, 40), bgcolor = zoneCol)

    if showFibs
        ln100 := line.new(legLeftTime, f100, rEdge, f100, xloc = xloc.bar_time, color = fibCol, style = line.style_dotted)
        ln075 := line.new(legLeftTime, f075, rEdge, f075, xloc = xloc.bar_time, color = fibCol, style = line.style_dotted)
        ln050 := line.new(legLeftTime, f050, rEdge, f050, xloc = xloc.bar_time, color = fibCol, style = line.style_dotted)
        ln025 := line.new(legLeftTime, f025, rEdge, f025, xloc = xloc.bar_time, color = fibCol, style = line.style_dotted)
        ln000 := line.new(legLeftTime, f000, rEdge, f000, xloc = xloc.bar_time, color = fibCol, style = line.style_dotted)

    if showLegLines
        lnHigh := line.new(legLeftTime, legHigh, rEdge, legHigh, xloc = xloc.bar_time, color = legCol, width = 2)
        lnLow  := line.new(legLeftTime, legLow,  rEdge, legLow,  xloc = xloc.bar_time, color = legCol, width = 2)

    if showFVG and not na(bestTop)
        bxFVG := box.new(legLeftTime, bestTop, rEdge, bestBot, xloc = xloc.bar_time, border_color = color.new(legCol, 20), bgcolor = fvgCol)

// -----------------------------------------------------------------------------
// Markers — major BOS (triangles) and confirmed Major-tier swing points. Gated
// by isNewHTF so each structure-timeframe event is marked exactly once.
// -----------------------------------------------------------------------------
plotshape(showBOS and evBearBOS and isNewHTF, title = "Bearish Major BOS", style = shape.triangledown, location = location.abovebar, color = bearCol, size = size.tiny, text = "BOS")
plotshape(showBOS and evBullBOS and isNewHTF, title = "Bullish Major BOS", style = shape.triangleup,   location = location.belowbar, color = bullCol, size = size.tiny, text = "BOS")

if showSwings and evNewSH and isNewHTF and not na(shT)
    label.new(shT, shP, "SH", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(bearCol, 20), textcolor = color.white, size = size.tiny)
if showSwings and evNewSL and isNewHTF and not na(slT)
    label.new(slT, slP, "SL", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(bullCol, 20), textcolor = color.white, size = size.tiny)

// -----------------------------------------------------------------------------
// Alerts — fire once per confirmed structure-timeframe event.
// -----------------------------------------------------------------------------
alertcondition(evBearBOS and isNewHTF, title = "Bearish Major BOS",     message = "H4 Bearish Major Break of Structure confirmed")
alertcondition(evBullBOS and isNewHTF, title = "Bullish Major BOS",     message = "H4 Bullish Major Break of Structure confirmed")
alertcondition(evLegBear  and isNewHTF, title = "Bearish Major Leg",     message = "H4 Bearish Major Leg created")
alertcondition(evLegBull  and isNewHTF, title = "Bullish Major Leg",     message = "H4 Bullish Major Leg created")
alertcondition(evInval    and isNewHTF, title = "Major Leg Invalidated", message = "H4 Major Leg invalidated")
