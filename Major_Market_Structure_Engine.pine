//@version=6
// =============================================================================
// Major Market Structure Engine (Bullish & Bearish) — H4 fixed timeframe
//
// Builds and maintains ONE Major Market Structure from a single, fixed structure
// timeframe (default H4 / 240m) no matter which chart timeframe it is applied
// to. The whole engine — confirmed 5-fractals, the N-tier hierarchy, the Major
// Leg, its Fibonacci, Premium/Discount zone and qualifying Fair Value Gap — is
// computed natively at the structure timeframe via request.security() and drawn
// on the chart with time-anchored objects.
//
// A DEBUG / VALIDATION layer (toggleable) plots every confirmed 5-fractal, the
// minor-structure zigzag, minor BOS and the Major-tier swing points, so the
// hierarchy promotion (minor -> major) can be visually verified. Turn Debug off
// to show only the clean Major Leg and its Fibonacci.
//
// All logic is close-based and non-repainting at the structure timeframe (wicks
// never confirm a break or invalidation); lookahead is off (no future leak).
// =============================================================================
indicator("Major Market Structure Engine (H4)", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
grpTF = "Structure Timeframe"
structureTF = input.timeframe("240", "Structure Timeframe", group = grpTF, tooltip = "The single timeframe the entire Major Structure is built from. Default 240 (H4). The chart may be lower (e.g. for entries); the H4 structure stays fixed. Using a chart timeframe ABOVE this is not supported.")

grpDisp = "Display (Major output)"
showLegLines = input.bool(false, "Leg High / Leg Low",        group = grpDisp)
showFibs     = input.bool(true,  "Fibonacci Levels",          group = grpDisp)
showZone     = input.bool(true,  "Premium / Discount Zone",   group = grpDisp)
showFVG      = input.bool(true,  "Fair Value Gap",            group = grpDisp)
showBOS      = input.bool(true,  "Major BOS Markers",         group = grpDisp)
showSwings   = input.bool(true,  "Major Swing Points (SH/SL)",group = grpDisp)
showTrade    = input.bool(true,  "Trade Framing (Entry/SL/TP + R)", group = grpDisp)

grpDebug = "Debug / Validation"
showDebug    = input.bool(true, "Enable Debug Hierarchy Visuals", group = grpDebug, tooltip = "Master switch for the validation layer. Turn OFF to show only the Major Leg and its Fibonacci.")
showFractals = input.bool(true, "    Confirmed 5-Fractals (H/L)", group = grpDebug)
showMinorZig = input.bool(true, "    Minor Structure Zigzag",     group = grpDebug)
showMinorBOS = input.bool(true, "    Minor (internal) BOS",       group = grpDebug)

grpInit = "Initialization"
initLookback = input.int(2000, "Reconstruction Window (bars)", minval = 100, maxval = 20000, group = grpInit, tooltip = "How many recent structure-timeframe bars to replay when reconstructing the active Major Leg on load. Larger = safer for long-lived legs, smaller = faster startup.")

grpStruct = "Major Structure"
depth = input.int(3, "Structure Depth (tiers)", minval = 1, maxval = 6, group = grpStruct, tooltip = "1 = raw 5-fractals, 2 = swing structure, 3 = major (recommended). 4-5 = HTF-only anchors. Each tier needs one more nested break, filtering minor/internal legs.")
useDisplacement = input.bool(true, "Require Displacement (FVG) on Major BOS", group = grpStruct, tooltip = "A Major BOS only creates a leg if the breaking impulse leaves a Fair Value Gap — an objective footprint of institutional intent. Filters slow, drifty breaks.")
dispLookback    = input.int(3, "Displacement Window (bars)", minval = 1, maxval = 10, group = grpStruct, tooltip = "Bars around the break scanned for a same-direction FVG (the impulse span). Structural, not a magnitude threshold.")
entryFib        = input.float(0.71, "Entry level 1 (0.71 = 2.45R)", minval = 0.5, maxval = 0.95, step = 0.005, group = grpStruct, tooltip = "Primary entry retracement, 100% at the fixed boundary (SL) and 0% at the impulse extreme (TP). 0.71 gives R = 0.71/0.29 = 2.45. This level also defines the FVG confluence zone.")
entryFib2       = input.float(0.79, "Entry level 2 (band)", minval = 0.5, maxval = 0.99, step = 0.005, group = grpStruct, tooltip = "Second entry line drawn alongside level 1 to show the 0.71-0.79 entry band, as in the model. Display only.")

grpCol = "Colors"
bearCol     = input.color(color.red,                    "Major Bearish (bold)", group = grpCol)
bullCol     = input.color(color.teal,                   "Major Bullish (bold)", group = grpCol)
fibCol      = input.color(color.new(color.gray, 0),     "Fib Lines",            group = grpCol)
zoneCol     = input.color(color.new(color.orange, 82),  "Zone Fill",            group = grpCol)
fvgCol      = input.color(color.new(color.blue, 72),    "FVG Fill",             group = grpCol)
fracHiCol   = input.color(color.orange,                 "Fractal High",         group = grpCol)
fracLoCol   = input.color(color.aqua,                   "Fractal Low",          group = grpCol)
minorCol    = input.color(color.new(color.gray, 35),    "Minor Legs (light)",   group = grpCol)
minorBosCol = input.color(color.fuchsia,                "Minor BOS",            group = grpCol)
entryLnCol  = input.color(color.yellow,                 "Entry line",           group = grpCol)
slLnCol     = input.color(color.new(color.red, 0),      "Stop Loss line",       group = grpCol)
tpLnCol     = input.color(color.new(color.green, 0),    "Take Profit line",     group = grpCol)

// Fractal geometry — 5 left, pivot, 5 right = the 11-candle confirmation window.
LEFT  = 5
RIGHT = 5
MAX_FVG = 300     // hard cap on stored FVGs per active leg (memory guard)
MAX_DEPTH = 6     // hierarchy tier capacity (must be >= the Structure Depth input max)

// -----------------------------------------------------------------------------
// Structure helpers — set a confirmed pivot at a hierarchy tier and roll the
// running branch-extreme promoted to the next tier up. "b" is the pivot bar TIME.
// -----------------------------------------------------------------------------
setPivotHigh(pvArr, tArr, armArr, runArr, runTArr, k, val, b) =>
    array.set(pvArr, k, val)
    array.set(tArr, k, b)
    array.set(armArr, k, true)
    r = array.get(runArr, k)
    if na(r) or val > r
        array.set(runArr, k, val)
        array.set(runTArr, k, b)

setPivotLow(pvArr, tArr, armArr, runArr, runTArr, k, val, b) =>
    array.set(pvArr, k, val)
    array.set(tArr, k, b)
    array.set(armArr, k, true)
    r = array.get(runArr, k)
    if na(r) or val < r
        array.set(runArr, k, val)
        array.set(runTArr, k, b)

// -----------------------------------------------------------------------------
// msEngine — the WHOLE engine, evaluated natively at the structure timeframe
// (inside request.security). Draws nothing; returns scalars (with pivot TIMES)
// for the chart to draw. Also emits per-bar confirmed-fractal and minor-break
// events for the debug layer.
// -----------------------------------------------------------------------------
// Price at a Fib fraction, measured with 100% at the FIXED boundary and 0% at
// the DYNAMIC (impulse) boundary — the convention used by the trade model:
//   1.0 = origin / SL, 0.0 = impulse extreme / TP, 0.71 = entry.
priceAtFrac(dir, lo, hi, f) => dir == -1 ? lo + f * (hi - lo) : hi - f * (hi - lo)

msEngine() =>
    confirmed = barstate.isconfirmed
    inWindow  = bar_index > last_bar_index - initLookback
    top       = depth - 1

    var array<float> pvHigh   = array.new_float(MAX_DEPTH, na)
    var array<int>   pvHighT  = array.new_int(MAX_DEPTH, na)
    var array<float> pvLow    = array.new_float(MAX_DEPTH, na)
    var array<int>   pvLowT   = array.new_int(MAX_DEPTH, na)
    var array<bool>  armHigh  = array.new_bool(MAX_DEPTH, false)
    var array<bool>  armLow   = array.new_bool(MAX_DEPTH, false)
    var array<float> runHigh  = array.new_float(MAX_DEPTH, na)
    var array<int>   runHighT = array.new_int(MAX_DEPTH, na)
    var array<float> runLow   = array.new_float(MAX_DEPTH, na)
    var array<int>   runLowT  = array.new_int(MAX_DEPTH, na)

    // Tier 0 input — confirmed 5-fractals feed the base of the hierarchy.
    ph = ta.pivothigh(LEFT, RIGHT)
    pl = ta.pivotlow(LEFT, RIGHT)
    if inWindow and not na(ph)
        setPivotHigh(pvHigh, pvHighT, armHigh, runHigh, runHighT, 0, ph, time[RIGHT])
    if inWindow and not na(pl)
        setPivotLow(pvLow, pvLowT, armLow, runLow, runLowT, 0, pl, time[RIGHT])

    // Debug: every confirmed fractal this bar (price + its pivot-bar time).
    fracHiP = inWindow and not na(ph) ? ph        : na
    fracHiT = inWindow and not na(ph) ? time[RIGHT] : na
    fracLoP = inWindow and not na(pl) ? pl        : na
    fracLoT = inWindow and not na(pl) ? time[RIGHT] : na

    // Displacement — same-direction 3-candle FVG in the impulse around this bar.
    bearDisp = false
    bullDisp = false
    if useDisplacement
        for k = 0 to 10
            if k > dispLookback
                break
            if high[k] < low[k + 2]
                bearDisp := true
            if low[k] > high[k + 2]
                bullDisp := true

    // Cascade the break operator up the tiers (lowest first).
    majBearBOS = false
    majBullBOS = false
    minBearBrk = false
    minBullBrk = false
    newMajSH   = false
    newMajSL   = false
    if inWindow and confirmed
        for j = 0 to MAX_DEPTH - 1
            if j > top
                break
            pvLoj = array.get(pvLow, j)
            pvHij = array.get(pvHigh, j)
            bBear = not na(pvLoj) and array.get(armLow, j)  and close < pvLoj
            bBull = not na(pvHij) and array.get(armHigh, j) and close > pvHij
            if j < top
                if bBear
                    array.set(armLow, j, false)
                    minBearBrk := true
                    rh = array.get(runHigh, j)
                    if not na(rh)
                        setPivotHigh(pvHigh, pvHighT, armHigh, runHigh, runHighT, j + 1, rh, array.get(runHighT, j))
                        array.set(runHigh, j, na)
                        newMajSH := j + 1 == top ? true : newMajSH
                if bBull
                    array.set(armHigh, j, false)
                    minBullBrk := true
                    rl = array.get(runLow, j)
                    if not na(rl)
                        setPivotLow(pvLow, pvLowT, armLow, runLow, runLowT, j + 1, rl, array.get(runLowT, j))
                        array.set(runLow, j, na)
                        newMajSL := j + 1 == top ? true : newMajSL
            else
                if bBear and (not useDisplacement or bearDisp)
                    array.set(armLow, j, false)
                    majBearBOS := true
                if bBull and (not useDisplacement or bullDisp)
                    array.set(armHigh, j, false)
                    majBullBOS := true

    // --- Major Leg state (created from the Major tier, gated by displacement) --
    var int   legDir       = 0
    var float legHigh      = na
    var float legLow       = na
    var int   legFixedTime = na   // TIME of the FIXED boundary (Fib start), never changes
    var bool  touched      = false
    var int   frozenTime   = na

    legCreatedBear = false
    legCreatedBull = false
    legInvalidated = false

    if confirmed and inWindow
        // Invalidation: close beyond the FIXED boundary.
        if legDir == -1 and close > legHigh
            legDir := 0
            legInvalidated := true
        else if legDir == 1 and close < legLow
            legDir := 0
            legInvalidated := true

        // Creation: anchored to the Major tier. The FIXED boundary defines the
        // Fibonacci start and is locked here for the life of the leg.
        if legDir == 0
            majHi  = array.get(pvHigh, top)
            majLo  = array.get(pvLow, top)
            majHiT = array.get(pvHighT, top)
            majLoT = array.get(pvLowT, top)
            if majBearBOS and not na(majHi) and not na(majLo)
                legDir       := -1
                legHigh      := majHi          // FIXED boundary
                legLow       := majLo          // DYNAMIC boundary (extends on lower lows)
                legFixedTime := majHiT         // Fib start = fixed major swing high
                touched      := false
                frozenTime   := na
                legCreatedBear := true
            else if majBullBOS and not na(majHi) and not na(majLo)
                legDir       := 1
                legLow       := majLo          // FIXED boundary
                legHigh      := majHi          // DYNAMIC boundary (extends on higher highs)
                legFixedTime := majLoT         // Fib start = fixed major swing low
                touched      := false
                frozenTime   := na
                legCreatedBull := true

        // Dynamic boundary extends the leg to new confirmed MINOR (tier-0) extremes.
        // Only the dynamic endpoint moves; the fixed boundary above stays put, so
        // the Fibonacci always spans the FULL active Major Leg, end to end.
        if legDir == -1 and not na(pl) and pl < legLow
            legLow := pl
        if legDir == 1 and not na(ph) and ph > legHigh
            legHigh := ph

    // --- Fibonacci + zone (0.00 = Leg Low, 1.00 = Leg High) -------------------
    float f000 = na
    float f025 = na
    float f050 = na
    float f075 = na
    float f100 = na
    float entry   = na
    float zoneTop = na
    float zoneBot = na
    if legDir != 0
        rng  = legHigh - legLow
        f000 := legLow
        f025 := legLow + rng * 0.25
        f050 := legLow + rng * 0.50
        f075 := legLow + rng * 0.75
        f100 := legHigh
        if legDir == -1
            entry   := legLow + rng * entryFib           // 71% up from the impulse low = premium entry
            zoneTop := f100
            zoneBot := entry
        else
            entry   := legLow + rng * (1.0 - entryFib)    // mirror: 71% down from the impulse high = discount entry
            zoneTop := entry
            zoneBot := f000

    // First-touch of the entry Fib freezes the drawing's right edge (by time).
    if confirmed and inWindow and legDir != 0 and not touched
        if (legDir == -1 and high >= entry) or (legDir == 1 and low <= entry)
            touched    := true
            frozenTime := time

    // --- Fair Value Gaps inside the active leg, largest fully inside the zone --
    var array<float> fvgTop = array.new_float()
    var array<float> fvgBot = array.new_float()
    var array<int>   fvgTyp = array.new_int()
    if legCreatedBear or legCreatedBull
        array.clear(fvgTop)
        array.clear(fvgBot)
        array.clear(fvgTyp)
    if confirmed and inWindow and legDir != 0
        bullFVG = low > high[2]
        bearFVG = high < low[2]
        if bullFVG
            array.push(fvgTop, low)
            array.push(fvgBot, high[2])
            array.push(fvgTyp, 1)
        if bearFVG
            array.push(fvgTop, low[2])
            array.push(fvgBot, high)
            array.push(fvgTyp, -1)
        while array.size(fvgTyp) > MAX_FVG
            array.shift(fvgTop)
            array.shift(fvgBot)
            array.shift(fvgTyp)

    float bestTop = na
    float bestBot = na
    if legDir != 0 and array.size(fvgTyp) > 0
        bestSize = -1.0
        for i = 0 to array.size(fvgTyp) - 1
            if array.get(fvgTyp, i) == legDir
                t = array.get(fvgTop, i)
                b = array.get(fvgBot, i)
                if b >= zoneBot and t <= zoneTop
                    sz = t - b
                    if sz > bestSize
                        bestSize := sz
                        bestTop  := t
                        bestBot  := b

    // Major-tier swing points (for SH/SL markers).
    shT = array.get(pvHighT, top)
    shP = array.get(pvHigh, top)
    slT = array.get(pvLowT, top)
    slP = array.get(pvLow, top)

    [legDir, legHigh, legLow, f000, f025, f050, f075, f100, zoneTop, zoneBot, bestTop, bestBot, legFixedTime, frozenTime, majBearBOS, majBullBOS, legCreatedBear, legCreatedBull, legInvalidated, newMajSH, newMajSL, shT, shP, slT, slP, fracHiP, fracHiT, fracLoP, fracLoT, minBearBrk, minBullBrk]

// -----------------------------------------------------------------------------
// Evaluate the engine at the structure timeframe (lookahead OFF = no future leak).
// -----------------------------------------------------------------------------
[legDir, legHigh, legLow, f000, f025, f050, f075, f100, zoneTop, zoneBot, bestTop, bestBot, legFixedTime, frozenTime, evBearBOS, evBullBOS, evLegBear, evLegBull, evInval, evNewSH, evNewSL, shT, shP, slT, slP, fracHiP, fracHiT, fracLoP, fracLoT, evMinBear, evMinBull] = request.security(syminfo.tickerid, structureTF, msEngine(), lookahead = barmerge.lookahead_off)

// True only on the first chart bar of each new structure-timeframe bar, so
// structure-timeframe events fire exactly once even on a lower chart timeframe.
isNewHTF = ta.change(time(structureTF)) != 0

// =============================================================================
// DEBUG / VALIDATION LAYER
// =============================================================================
// Confirmed 5-fractal markers, stamped at each fractal's own pivot bar time.
if showDebug and showFractals and isNewHTF
    if not na(fracHiT)
        label.new(fracHiT, fracHiP, "", xloc = xloc.bar_time, yloc = yloc.abovebar, style = label.style_triangledown, color = fracHiCol, size = size.tiny)
    if not na(fracLoT)
        label.new(fracLoT, fracLoP, "", xloc = xloc.bar_time, yloc = yloc.belowbar, style = label.style_triangleup, color = fracLoCol, size = size.tiny)

// Minor structure zigzag — connect consecutive confirmed fractals (light lines).
var int   lastFT = na
var float lastFP = na
if showDebug and showMinorZig and isNewHTF
    if not na(fracHiT)
        if not na(lastFT)
            line.new(lastFT, lastFP, fracHiT, fracHiP, xloc = xloc.bar_time, color = minorCol, width = 1)
        lastFT := fracHiT
        lastFP := fracHiP
    if not na(fracLoT)
        if not na(lastFT)
            line.new(lastFT, lastFP, fracLoT, fracLoP, xloc = xloc.bar_time, color = minorCol, width = 1)
        lastFT := fracLoT
        lastFP := fracLoP

// Minor (internal) BOS markers — small crosses, distinct from Major BOS.
plotshape(showDebug and showMinorBOS and evMinBear and isNewHTF, title = "Minor Bear BOS", style = shape.xcross, location = location.abovebar, color = minorBosCol, size = size.tiny)
plotshape(showDebug and showMinorBOS and evMinBull and isNewHTF, title = "Minor Bull BOS", style = shape.xcross, location = location.belowbar, color = minorBosCol, size = size.tiny)

// =============================================================================
// MAJOR OUTPUT LAYER — one active leg, time-anchored, Fib spanning the full leg.
// Objects extend right until first touch (frozenTime), then stay fixed. Handles
// are deleted and rebuilt each bar; all are removed when no leg is active.
// =============================================================================
// Fib is labelled the model's way: 1 (100%) at the FIXED boundary / SL, 0 (0%)
// at the impulse extreme / TP, with the 0.71 & 0.79 entry band between them.
var line  lnLegHi = na
var line  lnLegLo = na
var line  fL0   = na
var line  fL50  = na
var line  fL71  = na
var line  fL79  = na
var line  fL100 = na
var label bL0   = na
var label bL50  = na
var label bL71  = na
var label bL79  = na
var label bL100 = na
var box   bxZone = na
var box   bxFVG  = na
var label lbR   = na

if not na(lnLegHi)
    line.delete(lnLegHi)
if not na(lnLegLo)
    line.delete(lnLegLo)
if not na(fL0)
    line.delete(fL0)
if not na(fL50)
    line.delete(fL50)
if not na(fL71)
    line.delete(fL71)
if not na(fL79)
    line.delete(fL79)
if not na(fL100)
    line.delete(fL100)
if not na(bL0)
    label.delete(bL0)
if not na(bL50)
    label.delete(bL50)
if not na(bL71)
    label.delete(bL71)
if not na(bL79)
    label.delete(bL79)
if not na(bL100)
    label.delete(bL100)
if not na(bxZone)
    box.delete(bxZone)
if not na(bxFVG)
    box.delete(bxFVG)
if not na(lbR)
    label.delete(lbR)

if legDir != 0 and not na(legFixedTime)
    legCol = legDir == -1 ? bearCol : bullCol
    rEdge  = na(frozenTime) ? time : frozenTime
    p0   = priceAtFrac(legDir, legLow, legHigh, 0.0)        // 0  = impulse extreme / TP
    p50  = priceAtFrac(legDir, legLow, legHigh, 0.5)
    p71  = priceAtFrac(legDir, legLow, legHigh, entryFib)   // entry 1
    p79  = priceAtFrac(legDir, legLow, legHigh, entryFib2)  // entry 2
    p100 = priceAtFrac(legDir, legLow, legHigh, 1.0)        // 1  = fixed boundary / SL

    if showZone
        bxZone := box.new(legFixedTime, zoneTop, rEdge, zoneBot, xloc = xloc.bar_time, border_color = color.new(legCol, 60), bgcolor = zoneCol)

    if showFVG and not na(bestTop)
        bxFVG := box.new(legFixedTime, bestTop, rEdge, bestBot, xloc = xloc.bar_time, border_color = color.new(legCol, 20), bgcolor = fvgCol)

    if showFibs
        fL0   := line.new(legFixedTime, p0,   rEdge, p0,   xloc = xloc.bar_time, color = fibCol,     style = line.style_dotted)
        fL50  := line.new(legFixedTime, p50,  rEdge, p50,  xloc = xloc.bar_time, color = fibCol,     style = line.style_dotted)
        fL100 := line.new(legFixedTime, p100, rEdge, p100, xloc = xloc.bar_time, color = fibCol,     style = line.style_dotted)
        fL71  := line.new(legFixedTime, p71,  rEdge, p71,  xloc = xloc.bar_time, color = entryLnCol, width = 1)
        fL79  := line.new(legFixedTime, p79,  rEdge, p79,  xloc = xloc.bar_time, color = entryLnCol, width = 1)
        bL0   := label.new(rEdge, p0,   "0",                    xloc = xloc.bar_time, style = label.style_none, textcolor = fibCol,     size = size.small)
        bL50  := label.new(rEdge, p50,  "0.5",                  xloc = xloc.bar_time, style = label.style_none, textcolor = fibCol,     size = size.tiny)
        bL71  := label.new(rEdge, p71,  str.tostring(entryFib), xloc = xloc.bar_time, style = label.style_none, textcolor = entryLnCol, size = size.small)
        bL79  := label.new(rEdge, p79,  str.tostring(entryFib2),xloc = xloc.bar_time, style = label.style_none, textcolor = entryLnCol, size = size.small)
        bL100 := label.new(rEdge, p100, "1",                    xloc = xloc.bar_time, style = label.style_none, textcolor = fibCol,     size = size.small)

    if showLegLines
        lnLegHi := line.new(legFixedTime, legHigh, rEdge, legHigh, xloc = xloc.bar_time, color = legCol, width = 2)
        lnLegLo := line.new(legFixedTime, legLow,  rEdge, legLow,  xloc = xloc.bar_time, color = legCol, width = 2)

    // Trade framing: entry = 0.71 band, SL = level 1 (fixed), TP = level 0.
    if showTrade
        rr = entryFib / (1.0 - entryFib)
        lbR := label.new(rEdge, p71, (legDir == -1 ? "SHORT" : "LONG") + "  R " + str.tostring(rr, "#.##"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.gray, 20), textcolor = color.white, size = size.small)

// Major BOS markers (bold) and Major-tier swing points (prominent).
plotshape(showBOS and evBearBOS and isNewHTF, title = "Bearish Major BOS", style = shape.triangledown, location = location.abovebar, color = bearCol, size = size.small, text = "BOS")
plotshape(showBOS and evBullBOS and isNewHTF, title = "Bullish Major BOS", style = shape.triangleup,   location = location.belowbar, color = bullCol, size = size.small, text = "BOS")

if showSwings and evNewSH and isNewHTF and not na(shT)
    label.new(shT, shP, "SH", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(bearCol, 0), textcolor = color.white, size = size.small)
if showSwings and evNewSL and isNewHTF and not na(slT)
    label.new(slT, slP, "SL", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(bullCol, 0), textcolor = color.white, size = size.small)

// -----------------------------------------------------------------------------
// Alerts — fire once per confirmed structure-timeframe event.
// -----------------------------------------------------------------------------
alertcondition(evBearBOS and isNewHTF, title = "Bearish Major BOS",     message = "H4 Bearish Major Break of Structure confirmed")
alertcondition(evBullBOS and isNewHTF, title = "Bullish Major BOS",     message = "H4 Bullish Major Break of Structure confirmed")
alertcondition(evLegBear  and isNewHTF, title = "Bearish Major Leg",     message = "H4 Bearish Major Leg created")
alertcondition(evLegBull  and isNewHTF, title = "Bullish Major Leg",     message = "H4 Bullish Major Leg created")
alertcondition(evInval    and isNewHTF, title = "Major Leg Invalidated", message = "H4 Major Leg invalidated")
