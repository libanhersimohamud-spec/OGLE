//@version=6
// =============================================================================
// Major Market Structure Engine (Bullish & Bearish)
//
// Identifies, maintains and analyses the current major market structure in both
// bullish and bearish markets. The engine continuously detects confirmed market
// structure, identifies valid Breaks of Structure (BOS), builds a Major Leg,
// keeps that leg updated while it stays valid, and derives every trading
// component (Fibonacci levels, Premium/Discount Zone and the qualifying Fair
// Value Gap) from that single active Major Leg. Both directions use identical,
// fully mirrored logic.
//
// Confirmation model (non-repainting): market structure is built exclusively
// from confirmed swings. A swing is confirmed only after an 11-candle fractal
// completes — five candles to the left of the pivot, the pivot itself, and five
// candles to the right (ta.pivothigh/low(5, 5)). All BOS / invalidation events
// and every state mutation are committed on bar close only; wicks never confirm
// a BOS or an invalidation. Only one Major Leg may be active at a time.
// =============================================================================
indicator("Major Market Structure Engine (Bullish & Bearish)", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
grpDisp = "Display"
showLegLines = input.bool(true,  "Leg High / Leg Low",        group = grpDisp)
showFibs     = input.bool(true,  "Fibonacci Levels",          group = grpDisp)
showZone     = input.bool(true,  "Premium / Discount Zone",   group = grpDisp)
showFVG      = input.bool(true,  "Fair Value Gap",            group = grpDisp)
showBOS      = input.bool(true,  "Major BOS Markers",         group = grpDisp)
showSwings   = input.bool(true,  "Swing Structure Points",    group = grpDisp)

grpInit = "Initialization"
// On load the engine does NOT rebuild structure forward from the oldest candle.
// Instead it reconstructs only the currently-active Major Leg from a bounded
// window of the most recent bars (ending at the current candle). Pine executes
// strictly forward bar-by-bar, so the "scan backwards to reconstruct the active
// structure" requirement is realised as a bounded recent-window forward replay:
// replaying only the last `initLookback` bars naturally creates and discards any
// already-invalidated legs and leaves the engine anchored to the leg that is
// still active now — while never touching years of obsolete history. Raise this
// if an active leg legitimately began further back than the default window.
initLookback = input.int(2000, "Reconstruction Window (bars)", minval = 100, maxval = 20000, group = grpInit, tooltip = "How many recent bars to replay when reconstructing the active Major Leg on load. Larger = safer for long-lived legs, smaller = faster startup.")

grpCol = "Colors"
bearCol  = input.color(color.red,                       "Bearish",   group = grpCol)
bullCol  = input.color(color.teal,                      "Bullish",   group = grpCol)
fibCol   = input.color(color.new(color.gray, 0),        "Fib Lines", group = grpCol)
zoneCol  = input.color(color.new(color.orange, 82),     "Zone Fill", group = grpCol)
fvgCol   = input.color(color.new(color.blue, 72),       "FVG Fill",  group = grpCol)

// Fractal geometry — 5 left, pivot, 5 right = the 11-candle confirmation window.
LEFT  = 5
RIGHT = 5
MAX_FVG = 300   // hard cap on stored FVGs per active leg (memory guard)

confirmed = barstate.isconfirmed

// Reconstruction window: the engine only acts on bars inside the most recent
// `initLookback` bars. Bars older than the window are skipped entirely — their
// pivots are ignored, no legs are built from them, and nothing is drawn — so the
// engine never anchors to obsolete historical structure and startup stays fast.
// ta.pivothigh/low are still evaluated every bar (below) so their series stay
// consistent; only the ACTING on those values is gated by this window.
inWindow = bar_index > last_bar_index - initLookback

// -----------------------------------------------------------------------------
// 1. INTERNAL (minor) structure — confirmed 5-fractals
//
// ta.pivothigh/low(5, 5) only return a value once the full 11-candle fractal has
// completed, so a confirmed high/low is stamped 5 bars back. These are the
// INTERNAL (minor) swings. We keep the newest confirmed minor high and newest
// confirmed minor low; a run of same-type pivots collapses to the newest. The
// Major Leg is NOT built from these directly — they feed the swing layer below.
// -----------------------------------------------------------------------------
ph = ta.pivothigh(LEFT, RIGHT)
pl = ta.pivotlow(LEFT, RIGHT)

var float confHigh    = na
var int   confHighBar = na
var float confLow     = na
var int   confLowBar  = na

if inWindow and not na(ph)
    confHigh    := ph
    confHighBar := bar_index - RIGHT
if inWindow and not na(pl)
    confLow    := pl
    confLowBar := bar_index - RIGHT

// -----------------------------------------------------------------------------
// 2. INTERNAL breaks (close-based, one event per minor pivot)
//
// An internal break is a candle CLOSE beyond the latest confirmed minor pivot.
// These do not create Major Legs — they are the operator that confirms the
// higher-order SWING structure in section 3. A fresh minor pivot re-arms its
// side so each minor level triggers at most one internal break.
// -----------------------------------------------------------------------------
var bool lowArmed  = false
var bool highArmed = false
if inWindow and not na(pl)
    lowArmed := true
if inWindow and not na(ph)
    highArmed := true

intBearBreak = inWindow and confirmed and not na(confLow)  and lowArmed  and close < confLow
intBullBreak = inWindow and confirmed and not na(confHigh) and highArmed and close > confHigh
if intBearBreak
    lowArmed := false
if intBullBreak
    highArmed := false

// -----------------------------------------------------------------------------
// 2b. SWING (major) structure — the same close-break operator, one level up
//
// Deterministic two-tier hierarchy, no thresholds:
//   * runHigh / runLow accumulate the extreme confirmed MINOR pivot since the
//     last promotion of that side.
//   * An INTERNAL BEARISH break confirms the highest minor high of the branch
//     as a MAJOR SWING HIGH (then runHigh resets).
//   * An INTERNAL BULLISH break confirms the lowest minor low of the branch as
//     a MAJOR SWING LOW (then runLow resets).
// In an uptrend, repeated bullish internal breaks stamp a rising series of
// swing lows while runHigh keeps climbing until the first bearish internal
// break stamps the swing high — and mirror for a downtrend. This is exactly
// the "internal vs swing structure" nesting, produced by recursion of the
// fractal/close-break rule rather than any magnitude filter.
// -----------------------------------------------------------------------------
var float runHigh      = na
var int   runHighBar   = na
var float runLow       = na
var int   runLowBar    = na
var float swingHigh    = na
var int   swingHighBar = na
var float swingLow     = na
var int   swingLowBar  = na
var bool  majHighArmed = false
var bool  majLowArmed  = false

// Accumulate branch extremes from confirmed minor pivots.
if inWindow and not na(ph) and (na(runHigh) or ph > runHigh)
    runHigh    := ph
    runHighBar := bar_index - RIGHT
if inWindow and not na(pl) and (na(runLow) or pl < runLow)
    runLow    := pl
    runLowBar := bar_index - RIGHT

newSwingHigh = false
newSwingLow  = false
// A bearish internal break promotes the branch's highest minor high to a swing high.
if intBearBreak and not na(runHigh)
    swingHigh    := runHigh
    swingHighBar := runHighBar
    majHighArmed := true       // re-arm major bullish BOS against the new swing high
    runHigh      := na         // start a fresh search for the next swing high
    newSwingHigh := true
// A bullish internal break promotes the branch's lowest minor low to a swing low.
if intBullBreak and not na(runLow)
    swingLow    := runLow
    swingLowBar := runLowBar
    majLowArmed := true        // re-arm major bearish BOS against the new swing low
    runLow      := na
    newSwingLow := true

// -----------------------------------------------------------------------------
// 2c. MAJOR Break of Structure — close beyond a confirmed SWING point
//
// Bearish Major BOS: close below the latest Major Swing Low.
// Bullish Major BOS: close above the latest Major Swing High.
// One event per swing point (re-armed when a new swing point is confirmed).
// Only these events create a Major Leg.
// -----------------------------------------------------------------------------
majBearBOS = inWindow and confirmed and not na(swingLow)  and majLowArmed  and close < swingLow
majBullBOS = inWindow and confirmed and not na(swingHigh) and majHighArmed and close > swingHigh
if majBearBOS
    majLowArmed := false
if majBullBOS
    majHighArmed := false

// -----------------------------------------------------------------------------
// 3. Major Leg state
//
// The leg is created from SWING points on a MAJOR BOS. Once active:
// Bearish leg: Leg High is FIXED at creation, Leg Low is DYNAMIC (lower lows).
// Bullish leg: Leg Low  is FIXED at creation, Leg High is DYNAMIC (higher highs).
// The dynamic boundary tracks new confirmed MINOR extremes so the leg extends to
// the true high/low of the move. Only the first major BOS (while no leg exists)
// creates a leg; further same-direction major BOS are ignored — only the dynamic
// boundary keeps updating. Invalidation = close beyond the fixed boundary, which
// for the fixed swing high/low is itself the opposite-direction major BOS.
// -----------------------------------------------------------------------------
var int   legDir     = 0     // 0 = none, -1 = bearish, 1 = bullish
var float legHigh    = na
var float legLow     = na
var int   legLeftBar = na
var bool  touched    = false // has price first reached the entry Fib level?
var int   frozenRight = na   // right edge captured at first touch

legCreatedBear = false
legCreatedBull = false
legInvalidated = false

if confirmed and inWindow
    // --- Invalidation (close beyond the FIXED boundary) ---------------------
    if legDir == -1 and close > legHigh
        legDir := 0
        legInvalidated := true
    else if legDir == 1 and close < legLow
        legDir := 0
        legInvalidated := true

    // --- Creation (only when no leg is active) — built from SWING points -----
    if legDir == 0
        if majBearBOS and not na(swingHigh)
            legDir      := -1
            legHigh     := swingHigh                      // fixed (major swing high)
            legLow      := swingLow                       // dynamic (major swing low just broken)
            legLeftBar  := math.min(swingHighBar, swingLowBar)
            touched     := false
            frozenRight := na
            legCreatedBear := true
        else if majBullBOS and not na(swingLow)
            legDir      := 1
            legLow      := swingLow                       // fixed (major swing low)
            legHigh     := swingHigh                      // dynamic (major swing high just broken)
            legLeftBar  := math.min(swingHighBar, swingLowBar)
            touched     := false
            frozenRight := na
            legCreatedBull := true

    // --- Dynamic boundary update -------------------------------------------
    if legDir == -1 and not na(pl) and pl < legLow
        legLow := pl
    if legDir == 1 and not na(ph) and ph > legHigh
        legHigh := ph

// -----------------------------------------------------------------------------
// 4. Fibonacci levels, Premium / Discount Zone and entry level
//
// 0.00 anchors the Leg Low, 1.00 anchors the Leg High.
//   Bearish: Premium Zone = 0.75 → 1.00, entry Fib = 0.75.
//   Bullish: Discount Zone = 0.00 → 0.25, entry Fib = 0.25.
// -----------------------------------------------------------------------------
float f000 = na
float f025 = na
float f050 = na
float f075 = na
float f100 = na
float entry   = na
float zoneTop = na
float zoneBot = na

if legDir != 0
    rng  = legHigh - legLow
    f000 := legLow
    f025 := legLow + rng * 0.25
    f050 := legLow + rng * 0.50
    f075 := legLow + rng * 0.75
    f100 := legHigh
    if legDir == -1
        entry   := f075
        zoneTop := f100
        zoneBot := f075
    else
        entry   := f025
        zoneTop := f025
        zoneBot := f000

// First-touch detection — extension stops once price reaches the entry Fib.
if confirmed and inWindow and legDir != 0 and not touched
    if (legDir == -1 and high >= entry) or (legDir == 1 and low <= entry)
        touched     := true
        frozenRight := bar_index

// -----------------------------------------------------------------------------
// 5. Fair Value Gaps inside the active leg
//
// A 3-candle FVG completes on the current bar:
//   Bullish FVG: low > high[2]  → gap [high[2] .. low].
//   Bearish FVG: high < low[2]  → gap [high .. low[2]].
// While a leg is active we collect same-direction FVGs, then each bar keep the
// single LARGEST one that sits COMPLETELY inside the current zone. Arrays are
// reset whenever a new leg is created so only the active leg is ever scanned.
// -----------------------------------------------------------------------------
var array<float> fvgTop = array.new_float()
var array<float> fvgBot = array.new_float()
var array<int>   fvgTyp = array.new_int()

if legCreatedBear or legCreatedBull
    array.clear(fvgTop)
    array.clear(fvgBot)
    array.clear(fvgTyp)

if confirmed and inWindow and legDir != 0
    bullFVG = low > high[2]
    bearFVG = high < low[2]
    if bullFVG
        array.push(fvgTop, low)
        array.push(fvgBot, high[2])
        array.push(fvgTyp, 1)
    if bearFVG
        array.push(fvgTop, low[2])
        array.push(fvgBot, high)
        array.push(fvgTyp, -1)
    while array.size(fvgTyp) > MAX_FVG
        array.shift(fvgTop)
        array.shift(fvgBot)
        array.shift(fvgTyp)

// Select the largest same-direction FVG fully contained in the zone.
float bestTop = na
float bestBot = na
if legDir != 0 and array.size(fvgTyp) > 0
    bestSize = -1.0
    for i = 0 to array.size(fvgTyp) - 1
        if array.get(fvgTyp, i) == legDir
            t = array.get(fvgTop, i)
            b = array.get(fvgBot, i)
            if b >= zoneBot and t <= zoneTop
                sz = t - b
                if sz > bestSize
                    bestSize := sz
                    bestTop  := t
                    bestBot  := b

// -----------------------------------------------------------------------------
// 6. Drawing — objects extend right until first touch, then freeze; all objects
//    are removed on invalidation. Handles are deleted and rebuilt each bar so
//    the extend-until-touch behaviour needs no per-object bookkeeping.
// -----------------------------------------------------------------------------
var line  lnHigh = na
var line  lnLow  = na
var line  ln000  = na
var line  ln025  = na
var line  ln050  = na
var line  ln075  = na
var line  ln100  = na
var box   bxZone = na
var box   bxFVG  = na

if not na(lnHigh)
    line.delete(lnHigh)
if not na(lnLow)
    line.delete(lnLow)
if not na(ln000)
    line.delete(ln000)
if not na(ln025)
    line.delete(ln025)
if not na(ln050)
    line.delete(ln050)
if not na(ln075)
    line.delete(ln075)
if not na(ln100)
    line.delete(ln100)
if not na(bxZone)
    box.delete(bxZone)
if not na(bxFVG)
    box.delete(bxFVG)

if legDir != 0
    legCol = legDir == -1 ? bearCol : bullCol
    rEdge  = touched ? frozenRight : bar_index

    if showZone
        bxZone := box.new(legLeftBar, zoneTop, rEdge, zoneBot, border_color = color.new(legCol, 40), bgcolor = zoneCol)

    if showFibs
        ln100 := line.new(legLeftBar, f100, rEdge, f100, color = fibCol, style = line.style_dotted)
        ln075 := line.new(legLeftBar, f075, rEdge, f075, color = fibCol, style = line.style_dotted)
        ln050 := line.new(legLeftBar, f050, rEdge, f050, color = fibCol, style = line.style_dotted)
        ln025 := line.new(legLeftBar, f025, rEdge, f025, color = fibCol, style = line.style_dotted)
        ln000 := line.new(legLeftBar, f000, rEdge, f000, color = fibCol, style = line.style_dotted)

    if showLegLines
        lnHigh := line.new(legLeftBar, legHigh, rEdge, legHigh, color = legCol, width = 2)
        lnLow  := line.new(legLeftBar, legLow,  rEdge, legLow,  color = legCol, width = 2)

    if showFVG and not na(bestTop)
        bxFVG := box.new(legLeftBar, bestTop, rEdge, bestBot, border_color = color.new(legCol, 20), bgcolor = fvgCol)

// -----------------------------------------------------------------------------
// 7. Markers — major BOS (triangles) and confirmed swing structure points
// -----------------------------------------------------------------------------
plotshape(showBOS and majBearBOS, title = "Bearish Major BOS", style = shape.triangledown, location = location.abovebar, color = bearCol, size = size.tiny, text = "BOS")
plotshape(showBOS and majBullBOS, title = "Bullish Major BOS", style = shape.triangleup,   location = location.belowbar, color = bullCol, size = size.tiny, text = "BOS")

// A confirmed swing point is stamped at its own pivot bar (runHighBar/runLowBar).
if showSwings and newSwingHigh
    label.new(swingHighBar, swingHigh, "SH", style = label.style_label_down, color = color.new(bearCol, 20), textcolor = color.white, size = size.tiny)
if showSwings and newSwingLow
    label.new(swingLowBar, swingLow, "SL", style = label.style_label_up, color = color.new(bullCol, 20), textcolor = color.white, size = size.tiny)

// -----------------------------------------------------------------------------
// 8. Alerts — only fire after all confirmation rules are satisfied.
// -----------------------------------------------------------------------------
alertcondition(majBearBOS,     title = "Bearish Major BOS",     message = "Bearish Major Break of Structure confirmed")
alertcondition(majBullBOS,     title = "Bullish Major BOS",     message = "Bullish Major Break of Structure confirmed")
alertcondition(legCreatedBear, title = "Bearish Major Leg",     message = "Bearish Major Leg created")
alertcondition(legCreatedBull, title = "Bullish Major Leg",     message = "Bullish Major Leg created")
alertcondition(legInvalidated, title = "Major Leg Invalidated", message = "Major Leg invalidated")
